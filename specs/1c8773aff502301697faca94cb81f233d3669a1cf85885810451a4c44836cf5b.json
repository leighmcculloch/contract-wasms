    "function_v0": {
      "doc": "Mint credits into `user`'s wallet. Called by the backend's relayer\\nonly, on a confirmed UPI top-up (1 INR top-up -> 1 credit).\\nRaises `total_supply` to keep `total_supply == sum(balances)`.",
      "name": "mint",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
