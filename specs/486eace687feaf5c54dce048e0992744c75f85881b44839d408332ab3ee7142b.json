    "function_v0": {
      "doc": "Settle the auction. Anyone may submit the off-chain-computed `clearing_price`,\\nper-slot `fills`, `total_cleared` and a Groth16 `proof`. The contract rebuilds\\nthe circuit's public-signal vector from its *own* committed state and verifies\\nthe proof natively; only a genuinely correct clearing can pass.",
      "name": "settle",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": "u32"
        },
        {
