  {
    "function_v0": {
      "doc": "Winner / loser settlement for a single slot. The recorded bidder claims their\\n`fill` units at the uniform clearing price; unspent collateral is refunded.\\nLosers (`fill == 0`) simply get their full collateral back. The opening is\\nnever disclosed \\xe2\\x80\\x94 the proof already bound the fill to the commitment.",
      "name": "claim",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "slot",
          "type_": "u32"
        }
      ],
      "outputs": []
    }
  },
