    "function_v0": {
      "doc": "Stateless, permissionless on-chain audit of a clearing proof against the\\ncontract's configured verifying key. Returns whether the proof is valid for\\nthe given public signals. This is a public good (anyone can verify a clearing\\nnatively) and the most direct demonstration of ZK verification on Stellar.",
      "name": "verify_clearing",
      "inputs": [
        {
          "doc": "",
          "name": "proof",
          "type_": {
            "udt": {
              "name": "Proof"
