  {
    "function_v0": {
      "doc": "Upgrade the pool's WASM code in place (admin-gated).\\n\\nThis is the single most important mainnet safety valve: it lets a bug fix\\nor feature addition (deposit ASP membership is now enforced; still to come:\\nnon-membership on transfer/withdraw, `execute_settlement`) reuse the SAME\\npool address, so the Merkle tree, nullifier set, and root history all\\nsurvive and every user note stays valid. Without it, a fix means a new\\naddress with empty state and stranded funds.",
      "name": "upgrade",
      "inputs": [
        {
          "doc": "",
          "name": "new_wasm_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
