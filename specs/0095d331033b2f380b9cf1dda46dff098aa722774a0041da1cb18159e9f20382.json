    "function_v0": {
      "doc": "Release a funded milestone with atomic 3-way split.\\n\\nSplit logic (mirrors The Signal's approveMilestone):\\n- platform_fee = amount * platform_fee_bps / 10000\\n- connector_cut = platform_fee * connector_share_bps / 10000\\n- protocol_cut = platform_fee - connector_cut\\n- provider_cut = amount - platform_fee",
      "name": "release_milestone",
      "inputs": [
        {
          "doc": "",
          "name": "deal_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "milestone_idx",
          "type_": "u32"
        }
