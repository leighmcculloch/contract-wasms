    "function_v0": {
      "doc": "Create a new deal with defined participants, splits, and milestones.\\n\\n- `platform_fee_bps`: platform fee in basis points (1000 = 10%)\\n- `connector_share_bps`: connector's share of the platform fee in bps (4000 = 40%)\\n- `milestone_amounts`: vector of amounts for each milestone (in token units)",
      "name": "create_deal",
      "inputs": [
        {
          "doc": "",
          "name": "client",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "provider",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "connector",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_addr",
          "type_": "address"
        },
