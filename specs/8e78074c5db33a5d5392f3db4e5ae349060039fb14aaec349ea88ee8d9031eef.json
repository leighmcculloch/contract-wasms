  {
    "function_v0": {
      "doc": "Called ONLY by the Settlement contract.\\nReleases `amount` of the matched deposit to `recipient` (the counterparty)\\nand refunds any surplus (`deposit \\xe2\\x88\\x92 amount`) to the original depositor.\\n\\nThe surplus arises in a uniform-price batch auction: a buyer escrows USDC\\nat their *limit* price but the batch clears at a (better) uniform price, so\\nonly `amount` is owed to the seller \\xe2\\x80\\x94 the price-improvement difference must\\nreturn to the buyer, not leak to the counterparty.\\nThe Settlement auth check is non-negotiable \\xe2\\x80\\x94 no other caller can release funds.",
      "name": "release",
      "inputs": [
        {
          "doc": "",
          "name": "nullifier",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "recipient",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
