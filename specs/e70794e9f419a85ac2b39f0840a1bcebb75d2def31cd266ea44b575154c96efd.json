          "doc": "Minimum ledgers between slices",
          "name": "min_slice_gap",
          "type_": "u32"
        },
        {
          "doc": "Catch-up headroom: cumulative fill may exceed pro-rata schedule by\\ntotal_in * pace_tolerance_bps / 10000",
          "name": "pace_tolerance_bps",
          "type_": "u32"
        },
