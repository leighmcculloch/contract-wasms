    "function_v0": {
      "doc": "Place a TWAP order. Escrows `total_in` of token_in.\\n\\nPricing: pass limit_num/limit_den > 0 for a fixed floor (min token_out\\nper token_in). Pass 0/0 to bound each slice by the SwapBook oracle\\ninstead \\xe2\\x80\\x94 requires max_slippage_bps in 1..=1000 and a FRESH oracle\\nprice for the pair at placement time.",
      "name": "place_twap",
      "inputs": [
        {
          "doc": "",
          "name": "maker",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "total_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "end_ledger",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "limit_num",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "limit_den",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "max_slippage_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "max_slice_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_slice_gap",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "pace_tolerance_bps",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u64",
            "error_type": {
              "udt": {
                "name": "TwapError"
              }
            }
          }
        }
      ]
    }
  },
