  {
    "udt_struct_v0": {
      "doc": "One leg of a batch: BOTH proofs, bound by the two commitments they share.\\n\\nTwo proofs and not one. Intents never reach the chain \\xe2\\x80\\x94 the user sends the\\nphase-1 proof privately to the batcher \\xe2\\x80\\x94 so verifying only the leg would mean\\ntrusting the batcher that this leg's input notes exist and are unspent, which\\nis the ability to mint value.",
      "lib": "",
      "name": "BatchLegInput",
      "fields": [
        {
          "doc": "[0] merkleRoot [1] nf0 [2] nf1 [3] tradeCommitment [4] ownerCommitment\\n\\nv2: `inputTotal` and `fee` are gone from the publics. These vectors ride\\nin the transaction envelope, so a per-leg total there named the trade\\nsize to anyone decoding the tx even though the event hid it. The fee the\\ncontract accrues now arrives once, proven, as the aggregate's batchFee.",
          "name": "intent_inputs",
          "type_": {
            "vec": {
              "element_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "intent_proof",
          "type_": {
            "udt": {
              "name": "VProof"
            }
          }
        },
        {
          "doc": "[0] tradeCommitment [1] ownerCommitment [2] clearingPrice\\n[3] outCommitment [4] changeCommitment\\n\\nv2: `outAsset` is gone \\xe2\\x80\\x94 public, it was the leg's direction in the tx\\nenvelope, linkable to its intent through the shared trade commitment.",
          "name": "leg_inputs",
          "type_": {
            "vec": {
              "element_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "leg_proof",
          "type_": {
            "udt": {
              "name": "VProof"
            }
          }
        }
      ]
    }
