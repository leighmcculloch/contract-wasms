  {
    "function_v0": {
      "doc": "Withdraw (unshield) collateral to `recipient` by spending two input notes.\\n\\n# Recipient binding (Plan 3 item \\xe2\\x80\\x94 closed)\\nThe circuit binds a `recipient` field element; this transfers to the `recipient`\\nAddress arg only after cryptographically enforcing that it equals\\n`encode_recipient(&env, &recipient)` from the proof's `recipient_field` (checked\\nabove, before `verify_proof`). Without this a malicious relayer \\xe2\\x80\\x94 which is\\nmandatory on this path \\xe2\\x80\\x94 could redirect withdrawals to an address of its choosing.\\nSee `circuits/CARRY_FORWARD.md` (Plan 3, item 3) for the original gap writeup.\\n`payloads` carries exactly one encrypted note payload, for the change\\ncommitment. The withdrawn value leaves the pool transparently and has no\\nnote to recover.",
      "name": "unshield",
      "inputs": [
        {
          "doc": "",
          "name": "relayer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "proof",
          "type_": {
            "udt": {
              "name": "VProof"
            }
          }
        },
        {
          "doc": "",
          "name": "public_inputs",
          "type_": {
            "vec": {
              "element_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "recipient",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "screening_ref",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "payloads",
          "type_": {
            "vec": {
              "element_type": "bytes"
            }
          }
        }
      ],
      "outputs": []
    }
  },
