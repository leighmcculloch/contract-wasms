    "function_v0": {
      "doc": "Permissionless finalize after an undisputed window. Returns the\\nproposer's bond and freezes the outcome. Callable even when paused (I6).",
      "name": "finalize",
      "inputs": [
        {
          "doc": "",
          "name": "market_id",
