          "type_": {
            "option": {
              "value_type": "u32"
            }
          }
        },
        {
          "doc": "Pool payout per LP-share numerator, fixed at resolution.",
          "name": "pool_payout_total",
          "type_": "i128"
        },
        {
          "doc": "Max cumulative collateral a single address may spend buying into this\\nmarket. Part of the insider-trading mitigation. 0 = no cap.",
