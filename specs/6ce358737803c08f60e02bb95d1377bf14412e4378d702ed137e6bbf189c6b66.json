  {
    "function_v0": {
      "doc": "Arbiter (2-of-3 multisig Stellar account) settles a disputed market.\\nWinner of the bond game gets their bond back + half the loser's bond;\\nthe other half accrues to the protocol (anti-collusion: disputing your\\nown proposal from a second wallet always loses you half a bond).\\nCallable even when paused (I6).",
      "name": "arbiter_resolve",
      "inputs": [
        {
          "doc": "",
          "name": "market_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "outcome",
          "type_": {
            "udt": {
              "name": "Outcome"
            }
          }
        }
      ],
      "outputs": []
    }
  },
