  {
    "function_v0": {
      "doc": "Create a market and seed its AMM. Admin-gated in hackathon scope\\n(permissionless creation = spam + malicious-question risk; see L-1).\\nThe creator's `initial_liquidity` is split into equal YES/NO reserves\\n(starting price 0.50) and the creator receives LP shares, minus a\\nsmall permanently-locked amount (prevents full-drain / div-by-zero).",
      "name": "create_market",
      "inputs": [
        {
          "doc": "",
          "name": "creator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "question",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "category",
          "type_": "symbol"
        },
        {
          "doc": "",
          "name": "criteria_ref",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "lock_time",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "resolve_time",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "dispute_window",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "position_cap",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "bond",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "initial_liquidity",
          "type_": "i128"
        }
      ],
      "outputs": [
        "u64"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Add liquidity proportional to current reserves (Gnosis FPMM style):\\ndeposit `amount` collateral -> mint `amount` complete sets -> add the\\nproportional amounts to reserves -> refund the surplus outcome shares\\nto the LP as a position. LP shares minted pro-rata on the larger reserve.",
      "name": "add_liquidity",
      "inputs": [
        {
          "doc": "",
          "name": "market_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Remove liquidity BEFORE resolution: burn LP shares, receive pro-rata\\nYES/NO shares from the reserves (NOT collateral \\xe2\\x80\\x94 the pool cannot know\\nfinal value yet). After resolution use `claim_lp` instead.",
      "name": "remove_liquidity",
      "inputs": [
        {
          "doc": "",
          "name": "market_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "lp_amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Buy YES (buy_yes=true) or NO shares with `amount_in` collateral.\\nFees are taken from the input. Reverts if output < `min_shares_out`\\n(caller-side slippage protection) or the position cap is exceeded.",
      "name": "buy",
      "inputs": [
        {
          "doc": "",
          "name": "market_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "buy_yes",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_shares_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Sell `shares_in` YES/NO shares back to the pool for collateral.\\nUses the closed-form FPMM sell: solve (y + s - x)(n - x) = y*n for x\\n(selling YES), pay x minus fees. Rounding favors the pool.",
      "name": "sell",
      "inputs": [
        {
          "doc": "",
          "name": "market_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "sell_yes",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "shares_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_amount_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Propose an outcome after `resolve_time`, escrowing the market's bond.\\nAnyone can propose (permissionless) \\xe2\\x80\\x94 in practice Orakel's AI Result\\nAgent proposes first, but nothing on-chain privileges it.",
