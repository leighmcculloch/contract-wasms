            "vec": {
              "element_type": "val"
            }
          }
        },
        {
          "doc": "",
          "name": "contract",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "fn_name",
          "type_": "symbol"
        }
      ]
    }
