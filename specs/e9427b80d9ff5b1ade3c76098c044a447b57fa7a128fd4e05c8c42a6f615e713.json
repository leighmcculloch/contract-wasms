  {
    "function_v0": {
      "doc": "Refund the reward to the poster.\\n\\n- **Open** task: before `deadline + settle_grace` this is a\\nposter-authorized cancel; after it, permissionless.\\n- **Active** task (work submitted): locked until `deadline + settle_grace`\\nso the platform can settle to a winner without being front-run; after\\nthe window it is permissionless.",
      "name": "refund",
      "inputs": [
        {
          "doc": "",
          "name": "task_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
