  {
    "function_v0": {
      "doc": "Atomically fill reverse-side orders and escrow the remainder as a\\nnew sitting order \\xe2\\x80\\x94 the whole plan lands in ONE invocation, so the\\nbook cannot move between the fills and the placement.\\n\\nEach `FillSpec` targets an order selling `token_out` for `token_in`\\n(the reverse side of the new order). The maker acts as taker on\\nthose fills, paying `amount_out` of their token_in per fill. The\\npayments plus the escrowed remainder must not exceed `amount_in`.\\n\\nReturns the new order's id, or 0 if the fills consumed the full\\namount and nothing was placed. Placement params mirror place_order.",
      "name": "match_and_place",
      "inputs": [
        {
          "doc": "",
          "name": "maker",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_amount_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "expiry",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "price_mode",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "max_slippage_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "auto_route_after",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "excluded",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "fills",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "FillSpec"
                }
              }
            }
          }
        }
      ],
