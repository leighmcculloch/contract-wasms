          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Wind the circle down and release everyone's collateral.\\n\\nThe admin may do this at any time before the circle finishes. Anyone may\\ndo it once the current round has stalled past `round_timeout_ledgers` \\xe2\\x80\\x94\\nso an absent admin, or a defaulter whose collateral is spent and who can\\ntherefore no longer be slashed, can never strand the members' funds.\\n\\nThe current round is unwound: it never paid out, so contributions\\n(including those covered by a slash) go back to the contributors'\\ncollateral balances, ready to withdraw.",
      "name": "cancel",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
