  {
    "udt_union_v0": {
      "doc": "Where the circle is in its lifecycle. Collateral is only withdrawable once\\nthe circle has come to rest (`Finished` or `Cancelled`).",
      "lib": "",
      "name": "CircleStatus",
      "cases": [
        {
          "void_v0": {
            "doc": "Accepting members; nobody is committed yet, so joining is reversible.",
            "name": "Open"
          }
        },
        {
          "void_v0": {
            "doc": "Rounds are running.",
            "name": "Active"
          }
        },
        {
          "void_v0": {
            "doc": "Every member has received a payout.",
            "name": "Finished"
          }
        },
        {
          "void_v0": {
            "doc": "Wound down before completing.",
            "name": "Cancelled"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Leave a circle that hasn't started yet, taking the collateral back.\\nNothing is at stake before the first round, so this is unconditional \\xe2\\x80\\x94\\nmembers are never locked in by an admin who doesn't press start.",
      "name": "leave",
      "inputs": [
        {
          "doc": "",
          "name": "member",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Admin slashes a member who didn't contribute this round: their collateral\\ncovers the missed contribution and their reputation drops.",
      "name": "slash",
      "inputs": [
        {
          "doc": "",
          "name": "member",
          "type_": "address"
