  {
    "udt_error_enum_v0": {
      "doc": "",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "public-signal count doesn't match the embedded verifying key",
          "name": "MalformedVerifyingKey",
          "value": 1
        },
        {
          "doc": "no public signals supplied (we need at least the nullifier at index 0)",
          "name": "NoPublicSignals",
          "value": 2
        },
        {
          "doc": "the Groth16 pairing check failed \\xe2\\x80\\x94 the proof is not valid for this VK",
          "name": "InvalidProof",
          "value": 3
        },
        {
          "doc": "this email/proof was already sealed (nullifier seen before) \\xe2\\x80\\x94 anti-replay",
          "name": "AlreadySealed",
          "value": 4
        },
        {
          "doc": "a public signal is >= the BN254 scalar field modulus (non-canonical encoding)",
          "name": "FieldElementNotCanonical",
          "value": 5
        },
        {
          "doc": "resuming SHA-256 over the public suffix did not reproduce the DKIM bh=",
          "name": "SuffixMismatch",
          "value": 6
        },
        {
          "doc": "consumedBytes is not block-aligned or too small to contain a window",
          "name": "BadConsumed",
          "value": 7
        }
      ]
    }
