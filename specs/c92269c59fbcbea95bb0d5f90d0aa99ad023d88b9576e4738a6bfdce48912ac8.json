  {
    "function_v0": {
      "doc": "Verify a body proof AND seal it as a public attestation.\\n\\nCheck order is cheap-to-expensive (canonical form \\xe2\\x86\\x92 replay \\xe2\\x86\\x92 SHA over the\\nsuffix \\xe2\\x86\\x92 pairing) so invalid submissions cost the sponsor as little as\\npossible; nothing is persisted until every check has passed.\\n\\nNOTE: `suffix` rides in the transaction, so it is public forever in the\\nledger history. The client audits it for personal data and shows the user\\nexactly what will be published before submitting.",
      "name": "seal_body",
      "inputs": [
        {
          "doc": "",
          "name": "proof",
          "type_": {
            "udt": {
              "name": "Proof"
            }
          }
        },
        {
          "doc": "",
          "name": "pub_signals",
          "type_": {
            "vec": {
              "element_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "suffix",
          "type_": "bytes"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "bytes_n": {
                "n": 32
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Pure verification of proof + suffix, no state change. Returns true only\\nif BOTH the pairing check and the SHA completion against bh= pass.",
      "name": "verify_proof",
      "inputs": [
        {
          "doc": "",
          "name": "proof",
