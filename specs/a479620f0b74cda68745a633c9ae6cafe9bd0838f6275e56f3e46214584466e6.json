          "doc": "Platform fee rate in basis points",
          "name": "platform_rate",
          "type_": "u32"
        },
        {
          "doc": "Wallet address that receives platform fee when hired",
          "name": "platform_wallet",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "private_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "Probation lock in seconds (production: 30 * 24 * 3600 = 2_592_000)",
          "name": "probation_seconds",
          "type_": "u64"
        },
        {
          "doc": "Escrow token (usually USDC)",
          "name": "token",
          "type_": "address"
        }
      ]
    }
  },
