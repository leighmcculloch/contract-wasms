[
  {
    "udt_struct_v0": {
      "doc": "Configuration for a standard referral-based job escrow.\\nDefines the participating parties, the payment tokens, and the reward distribution logic.",
      "lib": "",
      "name": "ReferralConfig",
      "fields": [
        {
          "doc": "The anchor address representing the cross-border payment gateway",
          "name": "anchor_address",
          "type_": "address"
        },
        {
          "doc": "Total bounty deposited by the client",
          "name": "bounty_amount",
          "type_": "i128"
        },
        {
          "doc": "The candidate being hired",
          "name": "candidate",
          "type_": "address"
        },
        {
          "doc": "The client funding the escrow",
          "name": "client",
          "type_": "address"
        },
        {
          "doc": "Duration in seconds for the mandatory dispute window after confirmation",
          "name": "dispute_window_secs",
          "type_": "u64"
        },
        {
          "doc": "Ledger sequence after which the escrow expires and can be refunded",
          "name": "expiry_ledger",
          "type_": "u32"
        },
        {
          "doc": "Backend tracking ID \\xe2\\x80\\x94 used in events so SDP can map to DB record",
          "name": "job_id",
          "type_": "string"
        },
        {
          "doc": "The platform backend key responsible for co-signing actions (Ed25519)",
          "name": "platform_address",
          "type_": "address"
        },
        {
          "doc": "Platform's share in basis points (e.g., 2000 = 20%)",
          "name": "platform_rate",
          "type_": "u32"
        },
        {
          "doc": "Wallet address that receives platform fee when hired",
          "name": "platform_wallet",
          "type_": "address"
        },
        {
          "doc": "Scout's share in basis points (e.g., 8000 = 80%)",
          "name": "scout_rate",
          "type_": "u32"
        },
        {
          "doc": "Token used for escrow (usually USDC)",
          "name": "token",
          "type_": "address"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Tracks the lifecycle state of a referral escrow.",
      "lib": "",
      "name": "ReferralStatus",
      "fields": [
        {
          "doc": "The timestamp when the deposit was made, used to track dispute window",
          "name": "deposit_timestamp",
          "type_": "u64"
        },
        {
          "doc": "True if the client has deposited the required bounty",
          "name": "is_deposited",
          "type_": "bool"
        },
        {
          "doc": "True if a dispute has been opened by either party",
          "name": "is_disputed",
          "type_": "bool"
        },
        {
          "doc": "True if funds were refunded to the client after expiry",
          "name": "is_refunded",
          "type_": "bool"
        },
        {
          "doc": "True if funds have been released to the anchor/scout",
          "name": "is_released",
          "type_": "bool"
        },
        {
          "doc": "True if the platform fee has been released to platform_wallet",
          "name": "platform_fee_released",
          "type_": "bool"
        }
      ]
    }
  },
