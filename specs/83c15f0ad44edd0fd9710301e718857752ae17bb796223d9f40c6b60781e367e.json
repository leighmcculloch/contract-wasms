          "doc": "This `split_ref` was already settled \\xe2\\x80\\x94 a run can never be paid twice.",
          "name": "AlreadyPaid",
          "value": 7
        },
        {
          "doc": "No receipt exists for the requested `split_ref`.",
          "name": "ReceiptNotFound",
          "value": 8
        }
      ]
    }
