    "udt_error_enum_v0": {
      "doc": "Every failure mode is an explicit, contiguous `u32` so the TypeScript client\\ncan map a contract error straight to a user-facing message without guessing.",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "",
          "name": "AlreadyInitialized",
          "value": 1
        },
        {
          "doc": "",
          "name": "NotInitialized",
          "value": 2
        },
        {
          "doc": "",
          "name": "NotAuthorized",
          "value": 3
        },
        {
          "doc": "",
          "name": "Paused",
          "value": 4
        },
        {
          "doc": "An individual share, or the computed total, was not strictly positive.",
          "name": "InvalidAmount",
          "value": 5
        },
        {
          "doc": "recipients.len() != amounts.len(), or there were zero / too many lines.",
          "name": "InvalidSplit",
          "value": 6
        },
