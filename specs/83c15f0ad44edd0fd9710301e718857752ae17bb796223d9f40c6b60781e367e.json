  {
    "function_v0": {
      "doc": "Atomically fund and fan out one paycheck.\\n\\n`payer` pays `sum(amounts)` into the contract, which then pays each\\n`recipients[i]` exactly `amounts[i]` \\xe2\\x80\\x94 all in this single call. Writes a\\npermanent receipt under `split_ref`. Returns the total moved.\\n\\nAuth: the payer's signature (covers the inner pay-in transfer).",
      "name": "pay_split",
      "inputs": [
        {
          "doc": "",
          "name": "split_ref",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "payer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "recipients",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "amounts",
          "type_": {
            "vec": {
              "element_type": "i128"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
