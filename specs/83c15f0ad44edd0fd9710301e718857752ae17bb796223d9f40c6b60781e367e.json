  {
    "udt_struct_v0": {
      "doc": "A single immutable split receipt. Written exactly once per `split_ref` and\\nnever mutated: the permanent on-chain proof that one paycheck was fanned out\\nto every recipient inside a single atomic contract call.\\n\\n`split_ref` (the storage key) is sha256 of Sahod's run reference (32 bytes),\\nso the app can address a receipt directly and the same run can never be paid\\ntwice.",
      "lib": "",
      "name": "SplitReceipt",
      "fields": [
        {
          "doc": "Ledger sequence the split settled on (proof-of-time).",
          "name": "ledger",
          "type_": "u32"
        },
        {
          "doc": "The wallet that funded the split (the paycheck owner).",
          "name": "payer",
          "type_": "address"
        },
        {
          "doc": "How many recipients were paid in this run.",
          "name": "recipients",
          "type_": "u32"
        },
        {
          "doc": "Total paid in, in the token's minor units (stroops for XLM; 7 decimals).",
          "name": "total",
          "type_": "i128"
        }
      ]
    }
  },
