  {
    "function_v0": {
      "doc": "Claims a claimer's pro-rata share of the \"35% staker\" bucket for\\neach finalized epoch listed, based on how much USDC they had\\ndeposited in the Stability Pool at the time each epoch closed\\n(approximated by their *current* compounded deposit \\xe2\\x80\\x94 deposits are\\ngenerally stable/long-lived, so this is an acceptable trade-off vs.\\nstoring a full historical snapshot per depositor per epoch).",
      "name": "claim",
      "inputs": [
        {
          "doc": "",
          "name": "claimer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "epochs",
          "type_": {
            "vec": {
              "element_type": "u64"
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
