    "function_v0": {
      "doc": "Submit an opaque identity signal with replay protection.\\n\\nABI arguments:\\n`(relayer, identity_proof, encrypted_payload, action_type, nullifier, expires_at_ledger, identity_commitment, satellite, hostname)`.\\n\\n`primary` is not a caller-provided argument. It is derived from stored\\n`Distributor` during fee routing and then emitted in event payloads.",
      "name": "request_identity_signal",
      "inputs": [
        {
          "doc": "",
          "name": "relayer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "identity_proof",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "encrypted_payload",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "action_type",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "nullifier",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "expires_at_ledger",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "identity_commitment",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "satellite",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "hostname",
          "type_": "bytes"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Submits a tracking request.\\n\\nABI arguments:\\n`(caller, zk_proof, ephemeral_pubkey, ciphertext, satellite, request_type, hostname, spend_pub_commitment)`.\\n\\n`primary` is not a caller-provided argument. It is derived from stored\\n`Distributor` during fee routing and then emitted in event payloads.\\n\\nFee collection occurs before verification. Invalid proofs do not revert\\nafter payment; a failure event is emitted and the call returns.",
      "name": "request_tracking",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "zk_proof",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "epk",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        },
        {
          "doc": "",
          "name": "ciphertext",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        },
        {
          "doc": "",
          "name": "satellite",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "request_type",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "hostname",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "spend_pub_commitment",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Submits a stealth tracking request where the satellite is the caller.\\n\\nIn this mode the satellite is the authenticated party, fee payer, and\\non-chain caller. The user's G-address never appears on-chain.\\nVerification always uses the stealth VK. The on-chain `request_type`\\nis the generic stealth type (7); the actual operation type is encrypted\\ninside the ciphertext field.\\n\\nABI arguments:\\n`(satellite, zk_proof, ephemeral_pubkey, ciphertext, request_type, hostname, spend_pub_commitment)`.",
      "name": "request_stealth_tracking",
      "inputs": [
        {
          "doc": "",
          "name": "satellite",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "zk_proof",
          "type_": "bytes"
        },
        {
          "doc": "",
