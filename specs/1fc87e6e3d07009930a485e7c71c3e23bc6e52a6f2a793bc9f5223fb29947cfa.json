          "doc": "",
          "name": "range_secs",
          "type_": "u32"
        }
      ],
      "outputs": [
        "u64"
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "The XDR payload the `eth-bridge-circuit` emits when it observes a\\n`TwapRequested(string,uint32,address)` event on Sepolia. Unlike\\n`Round2Payload`/`FinalPayload` this carries no `request_id`: the\\ncontract mints a fresh one on accept, so the bridged request joins\\nthe same Round-2/3 pipeline as a Stellar-native `request_twap` call.\\n\\nField order, types, and `Option` wrapping are LOCKED \\xe2\\x80\\x94 both the\\nbridge circuit (XDR-encodes this on the host side) and the\\nfrontend (filters `twapreq` events by `originator`) depend on the\\nbyte-for-byte layout.",
      "lib": "",
      "name": "BridgeTriggerPayload",
      "fields": [
        {
          "doc": "",
          "name": "asset",
          "type_": "symbol"
        },
        {
          "doc": "`log.block_timestamp` from Sepolia \\xe2\\x80\\x94 deterministic across\\noperators, so it can't drift between the two witnesses.",
          "name": "block_timestamp",
          "type_": "u64"
        },
        {
          "doc": "`msg.sender` from the Sepolia `TwapRequested` event \\xe2\\x80\\x94 the\\nMetaMask wallet that paid Sepolia gas for the original\\ntrigger.",
          "name": "eth_origin",
          "type_": {
            "bytes_n": {
              "n": 20
            }
          }
        },
        {
          "doc": "Sepolia transaction hash, used by the host as the\\n`event_id_salt` so both operators collapse to the same\\n`event_id` and the contract dedups replays via\\n`is_event_seen`.",
          "name": "eth_tx_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "range_secs",
          "type_": "u32"
        }
      ]
    }
  },
