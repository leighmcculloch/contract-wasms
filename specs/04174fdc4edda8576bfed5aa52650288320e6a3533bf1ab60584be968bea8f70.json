  {
    "udt_union_v0": {
      "doc": "Storage keys. `Envelope` and `Claimed` live in *persistent* storage (they\\nmust outlive the contract instance); `Admin`/`Paused`/`Counter` live in\\n*instance* storage so they share the instance's TTL.",
      "lib": "",
      "name": "DataKey",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "Admin"
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "Paused"
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "Counter"
          }
        },
        {
          "tuple_v0": {
            "doc": "envelope id -> Envelope",
            "name": "Envelope",
            "type_": [
              "u64"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "(envelope id, claimer) -> () ; presence means \"already claimed once\"",
            "name": "Claimed",
            "type_": [
              "u64",
              "address"
            ]
          }
        }
      ]
    }
  },
  {
    "udt_enum_v0": {
      "doc": "How a multi-slot envelope distributes its balance across claimers.",
      "lib": "",
      "name": "SplitMode",
      "cases": [
        {
          "doc": "Every slot receives `total / slots`; the final claimer also sweeps any\\ninteger remainder so the envelope always settles to exactly zero.",
          "name": "Equal",
          "value": 0
        },
        {
          "doc": "Lucky-money mode \\xe2\\x80\\x94 each claimer gets a random portion, bounded so every\\nremaining slot is still guaranteed at least one unit.",
          "name": "Random",
          "value": 1
        }
      ]
    }
  },
  {
    "udt_enum_v0": {
      "doc": "Lifecycle of an envelope. An envelope is created `Active`; it becomes\\n`Completed` once every slot is claimed, or `Refunded` if the sender\\nreclaims the unclaimed remainder after expiry.",
      "lib": "",
      "name": "EnvelopeStatus",
      "cases": [
        {
          "doc": "",
          "name": "Active",
          "value": 0
        },
        {
          "doc": "",
          "name": "Completed",
          "value": 1
        },
        {
          "doc": "",
          "name": "Refunded",
          "value": 2
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A single escrowed red envelope. The contract custodies `remaining_amount`\\nof `token` until it is fully claimed or refunded.",
      "lib": "",
      "name": "Envelope",
      "fields": [
        {
          "doc": "Slots already claimed.",
          "name": "claimed_slots",
          "type_": "u32"
        },
        {
          "doc": "Unix timestamp (ledger time) after which claims stop and refund opens.",
          "name": "expiry",
          "type_": "u64"
        },
        {
          "doc": "Balance still held in escrow (decremented on each claim / refund).",
          "name": "remaining_amount",
          "type_": "i128"
        },
        {
          "doc": "sha256(preimage). A claimer must reveal a `preimage` that hashes to this.",
          "name": "secret_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "Funder; the only address allowed to refund after expiry.",
          "name": "sender",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "split",
          "type_": {
            "udt": {
              "name": "SplitMode"
            }
          }
        },
        {
          "doc": "",
          "name": "status",
          "type_": {
            "udt": {
              "name": "EnvelopeStatus"
            }
          }
        },
        {
          "doc": "Stellar Asset Contract (SAC) address of the escrowed asset, e.g. USDC.",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "Original deposit, in the token's minor units (USDC = 6 decimals).",
          "name": "total_amount",
          "type_": "i128"
        },
        {
          "doc": "Number of independent claim slots (1 = a classic single-recipient gift).",
          "name": "total_slots",
          "type_": "u32"
        }
      ]
    }
  },
