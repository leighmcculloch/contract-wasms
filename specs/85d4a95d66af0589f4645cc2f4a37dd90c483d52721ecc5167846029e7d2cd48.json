  {
    "function_v0": {
      "doc": "`from` mints a half-card bound to `claim_hash` (= sha256 of a secret held in\\nthe share link). Escrows `VOUCH_STAKE` Social XP from `from` (refunded on a\\ntimely claim, else slashed). New wallets get `STARTER_SOCIAL` first so the\\nfirst vouch is free. Per-day cap applies. Returns the vouch id.",
      "name": "mint_vouch",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "claim_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "note",
          "type_": "string"
        }
      ],
      "outputs": [
        "u64"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "`claimer` claims by presenting `secret` (sha256(secret) must equal claim_hash).\\nThe claimer earns SOCIAL XP (first-pair-only), the voucher's stake is refunded\\n(if the claim is within `VOUCH_TTL_SECS`), and the voucher's 2nd-order bonus is\\nreleased now if the claimer is already verified \\xe2\\x80\\x94 otherwise it is queued until\\nthe claimer performs a verified (Earned) action. Vouches never touch Earned.",
      "name": "claim_vouch",
      "inputs": [
        {
          "doc": "",
          "name": "claimer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "vouch_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "secret",
          "type_": "bytes"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Aggregate profile view \\xe2\\x80\\x94 social + earned + verified in ONE call. Purely\\ncomposes the existing getters; no new storage, no new write path. Cuts\\nget_profile-style callers from 2-3 round-trips down to 1.",
      "name": "get_profile",
      "inputs": [
        {
          "doc": "",
          "name": "addr",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "udt": {
            "name": "Profile"
          }
        }
      ]
    }
  },
