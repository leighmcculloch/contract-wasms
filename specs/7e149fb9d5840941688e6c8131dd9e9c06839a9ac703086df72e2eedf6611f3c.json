          "type_": "i128"
        },
        {
          "doc": "",
          "name": "usdc_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "match_proof",
          "type_": {
            "udt": {
              "name": "Groth16Proof"
            }
          }
        },
        {
          "doc": "",
          "name": "match_public_signals",
          "type_": {
            "vec": {
              "element_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }
          }
        }
      ],
      "outputs": []
    }
