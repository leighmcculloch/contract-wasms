      "name": "verify_bridge_header",
      "inputs": [
        {
          "doc": "",
          "name": "chain",
          "type_": "symbol"
        },
        {
          "doc": "",
          "name": "block_number",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "state_root",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "proof_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "public_inputs",
          "type_": "bytes"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bool",
            "error_type": {
              "udt": {
                "name": "VerifierError"
              }
            }
          }
        }
      ]
    }
  },
