    "function_v0": {
      "doc": "Verify a ZK KYC credential proof off-chain and register the result on ledger.\\n\\nArguments:\\n- `applicant_hash`: SHA-256(applicant_id), 32 bytes. The actual identity stays private.\\n- `credential_type`: one of \"accredited\", \"kyc_aml\", \"age_18plus\"\\n- `proof_hash`: SHA-256 of the RISC Zero receipt bytes \\xe2\\x80\\x94 proves the computation\\n- `public_inputs`: serialized public journal from the ZK receipt (compact, no private data)",
      "name": "verify_kyc_proof",
      "inputs": [
        {
          "doc": "",
          "name": "applicant_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "credential_type",
          "type_": "symbol"
        },
        {
          "doc": "",
          "name": "proof_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "public_inputs",
          "type_": "bytes"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bool",
            "error_type": {
              "udt": {
                "name": "VerifierError"
              }
            }
          }
        }
      ]
    }
  },
