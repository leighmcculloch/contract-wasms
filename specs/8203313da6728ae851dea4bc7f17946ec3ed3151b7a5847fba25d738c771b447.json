  {
    "function_v0": {
      "doc": "`caller` should be `e.current_contract_address()`. It replaces\\n`statement.target` before hashing, so an attestation only works for the\\ncontract presenting it; every other field is trusted exactly as passed.\\n\\nExpiry, replay, uuid or expiration disagreement, and an unregistered\\nattester return a [`RegistryError`]. An invalid signature instead aborts\\nthe invocation with `Error(Crypto, InvalidInput)`, which is why no\\n`InvalidSignature` variant exists. Neither outcome spends the uuid.",
      "name": "validate_attestation",
      "inputs": [
        {
          "doc": "",
          "name": "statement",
          "type_": {
            "udt": {
              "name": "Statement"
            }
          }
        },
        {
          "doc": "",
          "name": "attestation",
          "type_": {
            "udt": {
              "name": "Attestation"
            }
          }
        },
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "tuple": {
                "value_types": []
              }
            },
            "error_type": {
              "udt": {
                "name": "RegistryError"
              }
            }
          }
        }
      ]
    }
  },
