    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "Config",
      "fields": [
        {
          "doc": "Raw Ed25519 public key of the off-chain backend signer that produces\\nmerchant-quote signatures. Deliberately not a Stellar `Address` \\xe2\\x80\\x94 the\\nbackend is a pure signing key, not an on-chain account (same role as\\n`backendSigner` on EVM and `backend_signer` on Solana).",
          "name": "backend_signer",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "owner",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "paused",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "pending_owner",
          "type_": {
            "option": {
              "value_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "point_deposit_counter",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "point_deposits_paused",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "tx_counter",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "withdrawal_delay",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "withdrawal_nonce",
          "type_": "u64"
        }
      ]
    }
  },
  {
    "udt_union_v0": {
      "doc": "",
      "lib": "",
      "name": "DataKey",
      "cases": [
        {
          "void_v0": {
            "doc": "Singleton config, lives in instance storage.",
            "name": "Config"
          }
        },
        {
          "tuple_v0": {
            "doc": "admin address -> marker. Presence in persistent storage == is admin.",
            "name": "Admin",
            "type_": [
              "address"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "token address -> max per-transaction amount (0 / absent = unbounded).",
            "name": "SpendingLimit",
            "type_": [
              "address"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "tx_id -> TransactionRecord.",
            "name": "TxRecord",
            "type_": [
              "u64"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "sha256(ref_id) -> replay marker for create_transaction.",
            "name": "RefRecord",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "sha256(ref_id) -> MerchantPayment. Presence == quote already consumed.",
            "name": "MerchantPayment",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "token address -> accrued platform fee (i128).",
            "name": "PlatformFee",
            "type_": [
              "address"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "deposit_id -> PointDepositRecord.",
            "name": "PointDeposit",
            "type_": [
              "u64"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "sha256(ref_id) -> replay marker for deposit_points.",
            "name": "PointRef",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "token address -> marker. Presence == allowed for payments and point\\ndeposits (create_transaction + process_merchant_payment + deposit_points).",
            "name": "AllowedPaymentToken",
            "type_": [
              "address"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "nonce -> WithdrawalRequest.",
            "name": "Withdrawal",
            "type_": [
              "u64"
            ]
          }
        }
      ]
    }
  },
