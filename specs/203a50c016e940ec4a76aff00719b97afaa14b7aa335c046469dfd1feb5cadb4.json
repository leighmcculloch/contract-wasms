  {
    "udt_struct_v0": {
      "doc": "Trust matrix for the post-deadline escape hatch. The owner may sweep any\\nUNCLAIMED remainder strictly after `claim_deadline`, via the two-step\\n`initiate_reclaim`/`execute_reclaim`. Both fields are fixed at creation and\\ncannot be moved later (no setter exists).\\n\\n`max_unlock_time` is the last unlock the creator DECLARES for the schedule\\nhidden in the merkle leaves. The contract cannot verify it \\xe2\\x80\\x94 unlock times\\nonly ever arrive one epoch at a time as public input 19 \\xe2\\x80\\x94 so it is a\\npublished claim, not a proof. Storing it makes a creator whose declaration\\ncontradicts the pinned IPFS schedule detectable off chain; `MIN_CAMPAIGN_LIFETIME`\\nis what bounds the damage on chain.",
      "lib": "",
      "name": "ReclaimInfo",
      "fields": [
        {
          "doc": "",
          "name": "claim_deadline",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "max_unlock_time",
          "type_": "u64"
        }
      ]
    }
  },
