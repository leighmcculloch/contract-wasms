  {
    "function_v0": {
      "doc": "Registers a vault with the proxy. The signer is `config.admin` \\xe2\\x80\\x94 the\\naddress that controls the vault through the proxy going forward \\xe2\\x80\\x94 and must\\nalso be the vault's current Manager (the vault's `set_manager` call below\\nindependently enforces this). Requiring the signer to be `config.admin`\\nprevents a partner from accidentally (or maliciously, via a compromised\\nUI) delegating proxy-side admin rights to an address that never\\nauthenticated.",
      "name": "register_vault",
      "inputs": [
        {
          "doc": "",
          "name": "vault",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "config",
          "type_": {
            "udt": {
              "name": "VaultConfig"
            }
          }
        }
