  {
    "function_v0": {
      "doc": "Quote a fill from the TAKER's perspective.\\n\\nThe taker wants to acquire `token_buy` and pay with `token_pay`.\\nScans orders where makers sell `token_buy` for `token_pay`\\n(i.e. PairIndex(token_buy, token_pay)) and greedily computes how much\\n`token_buy` the taker receives for spending up to `amount_pay`\\n(before protocol fee).\\n\\nReturns (amount_bought, amount_paid).",
      "name": "quote_fill",
      "inputs": [
        {
          "doc": "",
          "name": "token_buy",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_pay",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_pay",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "tuple": {
            "value_types": [
              "i128",
              "i128"
            ]
          }
        }
      ]
    }
  },
