  {
    "function_v0": {
      "doc": "Claim a timer-expired order. Only the authorized Router CONTRACT can\\ncall this (invoker auth). The escrowed tokens transfer to the router,\\nwhich must \\xe2\\x80\\x94 within the same invocation \\xe2\\x80\\x94 execute the DEX route and\\npay the maker at least `min_out` of token_out.\\n\\n`min_out` is derived on-chain from the order's own price terms:\\nFixed  \\xe2\\x86\\x92 pro-rata min_amount_out over the remaining amount\\nOracle \\xe2\\x86\\x92 current fresh oracle fair value minus max_slippage_bps",
      "name": "claim_expired_timer",
      "inputs": [
        {
          "doc": "",
          "name": "order_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "udt": {
                "name": "ClaimedOrder"
              }
            },
            "error_type": {
              "udt": {
                "name": "SwapBookError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Update an oracle price for a token pair. Only the oracle admin can call.\\n\\nHardening:\\n- num and den must be strictly positive\\n- consecutive updates may not deviate more than MAX_ORACLE_JUMP_BPS\\nfrom the stored price (bounds damage from a compromised key)",
      "name": "update_oracle_price",
      "inputs": [
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
