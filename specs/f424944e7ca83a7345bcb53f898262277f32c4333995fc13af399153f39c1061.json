          "doc": "",
          "name": "price_num",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "price_den",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "SwapBookError"
              }
            }
          }
        }
      ]
    }
