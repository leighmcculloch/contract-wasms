          "type_": "u64"
        },
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "deposit_cap",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Admin-adjustable global cap on capital at risk (liquidity + principal)\\nper agent vault. Caps the blast radius of an undiscovered bug: no single\\nvault can ever hold more than this, no matter how much lenders want to\\ndeposit. 0 = uncapped.",
      "name": "set_deposit_cap",
      "inputs": [
        {
          "doc": "",
          "name": "new_cap",
          "type_": "i128"
        }
      ],
      "outputs": []
