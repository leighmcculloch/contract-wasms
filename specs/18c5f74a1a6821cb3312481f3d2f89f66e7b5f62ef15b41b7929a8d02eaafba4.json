  {
    "function_v0": {
      "doc": "Circuit breaker: halt new deposits and new borrows. Exits (repay,\\nwithdraw, claim_yield) and mark_default always keep working \\xe2\\x80\\x94 pausing\\ncan never trap anyone's funds, it only stops NEW risk from being taken.",
      "name": "pause",
      "inputs": [],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Agent repays. Payment covers accrued interest first \\xe2\\x80\\x94 a cut of which funds\\nthe reserve and the rest becomes lender yield \\xe2\\x80\\x94 then principal (\\xe2\\x86\\x92 returned\\nto lendable liquidity). Full repayment clears the repayment clock.",
      "name": "repay",
      "inputs": [
        {
          "doc": "",
          "name": "agent",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
