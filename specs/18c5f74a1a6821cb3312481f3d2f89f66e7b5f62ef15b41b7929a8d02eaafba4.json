  {
    "function_v0": {
      "doc": "Permissionless default trigger: once an agent's loan is past its due date\\nand principal remains outstanding, anyone may crystallise the default. The\\nreserve absorbs the loss first; the unrecovered remainder is socialised to\\nthe vault's lenders (share value falls); the agent is frozen out of\\nfurther borrowing. Isolated to this agent's vault.",
      "name": "mark_default",
      "inputs": [
        {
          "doc": "",
          "name": "agent",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Bind the vault to a score_registry (for limits), the USDC SEP-41 SAC, the\\nloan term (seconds) a fresh draw must be repaid within, an admin (can\\npause/unpause and adjust the deposit cap), and an initial global deposit\\ncap per agent vault (0 = uncapped).",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "registry",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
