            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Stop a stream early. The payer settles whatever has vested so far to the\\nrecipient and reclaims the unvested remainder. Returns the reclaimed\\namount.\\n\\nAuth: requires the payer's signature.",
      "name": "stop",
      "inputs": [
