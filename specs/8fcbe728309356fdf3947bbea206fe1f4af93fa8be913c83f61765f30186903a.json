    "function_v0": {
      "doc": "Lock `total_amount` of the configured token into a new stream and return\\nits id. Vesting runs linearly from `start_time` to `end_time`.\\n\\nAuth: requires the payer's signature. The same authorization covers the\\ninner SAC `transfer(payer -> contract)`.",
      "name": "create_stream",
      "inputs": [
        {
          "doc": "",
          "name": "payer",
          "type_": "address"
        },
        {
          "doc": "",
