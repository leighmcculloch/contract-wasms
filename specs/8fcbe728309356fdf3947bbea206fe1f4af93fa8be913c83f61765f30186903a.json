            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Withdraw everything that has vested but not yet been paid out. Funds are\\nalways sent to the stream's fixed `recipient`, so this is intentionally\\npermissionless (anyone may poke it; nobody but the recipient can be paid).\\nReturns the amount transferred.",
      "name": "withdraw",
      "inputs": [
        {
          "doc": "",
          "name": "stream_id",
          "type_": "u64"
        }
