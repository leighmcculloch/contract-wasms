  {
    "udt_enum_v0": {
      "doc": "Lifecycle of a stream. Created `Active`; becomes `Completed` once the\\nrecipient has withdrawn the entire deposit, or `Stopped` if the payer\\nhalts it early (vested portion settled to the recipient, the unvested\\nremainder reclaimed by the payer).",
      "lib": "",
      "name": "StreamStatus",
      "cases": [
        {
          "doc": "",
          "name": "Active",
          "value": 0
        },
        {
          "doc": "",
          "name": "Completed",
          "value": 1
        },
        {
          "doc": "",
          "name": "Stopped",
          "value": 2
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A single linear-vesting salary/grant stream. The contract custodies\\n`total_amount - withdrawn_amount` of `token` until it is fully withdrawn\\nor stopped. Vesting is computed purely from on-chain ledger time, so the\\namount available is always trustlessly derivable with no off-chain timer.",
      "lib": "",
      "name": "Stream",
      "fields": [
        {
          "doc": "Ledger unix timestamp (seconds) when the stream is fully vested.",
          "name": "end_time",
          "type_": "u64"
        },
        {
          "doc": "Funder; the only address allowed to stop the stream and reclaim the\\nunvested remainder.",
          "name": "payer",
          "type_": "address"
        },
        {
          "doc": "Beneficiary; every withdrawal is paid to exactly this address.",
          "name": "recipient",
          "type_": "address"
        },
        {
          "doc": "Ledger unix timestamp (seconds) when vesting begins.",
          "name": "start_time",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "status",
          "type_": {
            "udt": {
              "name": "StreamStatus"
            }
          }
        },
        {
          "doc": "Stellar Asset Contract (SAC) address of the streamed asset (XLM SAC).",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "Total deposit locked at creation, in the token's raw units (stroops for\\nthe native XLM SAC = 7 decimals).",
          "name": "total_amount",
          "type_": "i128"
        },
        {
          "doc": "Cumulative amount already paid out to the recipient.",
          "name": "withdrawn_amount",
          "type_": "i128"
        }
      ]
    }
  },
  {
