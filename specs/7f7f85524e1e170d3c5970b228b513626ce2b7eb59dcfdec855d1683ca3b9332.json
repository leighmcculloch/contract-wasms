    "udt_struct_v0": {
      "doc": "Immutable configuration, set once at construction.\\n\\nDecimals are cached here (read once from the token / oracle contracts) so the per-call\\npricing math doesn't pay repeated cross-contract `decimals()` reads.",
      "lib": "",
      "name": "Config",
      "fields": [
        {
          "doc": "Pool selector hash within `aqua_tokens` (Aqua addresses pools by (tokens, index)).",
          "name": "aqua_pool_index",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "Aquarius AMM router used for both the executed swap and the non-mutating quote.",
          "name": "aqua_router",
          "type_": "address"
        },
        {
          "doc": "The pool's token set, sorted ascending by address (Aqua requires sorted tokens).",
          "name": "aqua_tokens",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "Underlying asset the vault deposits/withdraws (USDC).",
          "name": "asset",
          "type_": "address"
        },
        {
          "doc": "Decimals of `asset` (USDC), cached.",
          "name": "asset_decimals",
          "type_": "u32"
        },
        {
          "doc": "SEP-40 price feed (Reflector-shaped) used to cross-check the Aqua quote.",
          "name": "oracle",
          "type_": "address"
        },
        {
          "doc": "Decimals the oracle reports prices in, cached.",
          "name": "oracle_decimals",
          "type_": "u32"
        },
        {
          "doc": "Value-accruing RWA the strategy swaps into and holds (e.g. CETES).",
          "name": "rwa_asset",
          "type_": "address"
        },
        {
          "doc": "Decimals of `rwa_asset`, cached.",
          "name": "rwa_decimals",
          "type_": "u32"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Keeper-tunable parameters. Updated wholesale by the keeper-gated extension methods so\\nevery change is a single atomic instance write.",
      "lib": "",
