    "function_v0": {
      "doc": "Adds a contract `hash` (wasm code hash) to the deposit allowlist. Keeper-gated;\\nidempotent. Any contract whose code hash matches may then deposit, regardless of its\\naddress \\xe2\\x80\\x94 bless a vault's wasm once and every instance of it is allowed. Because vault\\ncode hashes are known at build/upload time, the keeper can allowlist a hash before any\\nsuch vault is deployed. Note: a vault that upgrades its wasm changes hash and must be\\nre-blessed.",
      "name": "add_allowed_hash",
      "inputs": [
        {
          "doc": "",
          "name": "hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
