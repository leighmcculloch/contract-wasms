    "udt_union_v0": {
      "doc": "How a withdrawal returns funds. Both variants are handled live by\\n`withdraw.rs::deliver`: `Raw` returns the redeemed underlying as-is, and\\n`Normalize` swaps each redeemed underlying into `asset` via the router. A\\nsame-asset `Normalize` succeeds without a swap; a real cross-asset swap\\nreverts `AdapterError` while the Router is unset (dormant-by-config, not\\nrejected by shape) and activates by config \\xe2\\x80\\x94 the signature never changes.\\n(soroban-sdk `#[contracttype]` enums don't allow named-field variants, so the\\npayload is a one-field wrapper struct.)",
      "lib": "",
      "name": "WithdrawOut",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "Raw"
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "Normalize",
            "type_": [
              {
                "udt": {
                  "name": "NormalizeOut"
                }
              }
            ]
          }
        }
      ]
    }
  },
