[
  {
    "udt_error_enum_v0": {
      "doc": "Error codes live at 200+ **on purpose**, for the same reason `vesting` moved\\nto 100+.\\n\\n`create_campaign` reaches `fund_deployment` \\xe2\\x86\\x92 `token_client.transfer_from`,\\nand a Stellar Asset Contract raises its own `contracterror` codes across\\n1\\xe2\\x80\\x9313 \\xe2\\x80\\x94 including `AllowanceError = 9` and `BalanceError = 10`. Under the old\\n1..=10 numbering EVERY factory code collided with that range, and the two\\nmost common real failures of an atomic create (no allowance, no balance)\\nsurfaced as `#9`/`#10`, which the factory ABI decoded as `InvalidDeadline`\\nand `InvalidCampaignMode`. A caller seeing a bare `Error(Contract, #N)`\\ncould not tell \"you forgot to approve\" from \"your campaign shape is wrong\",\\nand the mislabel got sharper with `InvalidCampaignMode` becoming exactly\\nwhat a stale client hits when it calls this factory with the old campaign\\nshape \\xe2\\x80\\x94 rendered to the user as \"insufficient balance\".\\n\\n200+ rather than 100+ because the deployed contracts already own their own\\nblocks. All four ranges are disjoint by construction ",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "",
          "name": "NotInitialized",
          "value": 201
        },
        {
          "doc": "",
          "name": "InvalidRecipientCount",
          "value": 202
        },
        {
          "doc": "",
          "name": "InvalidAmount",
          "value": 203
        },
        {
          "doc": "",
          "name": "InvalidLimit",
          "value": 204
        },
        {
          "doc": "",
          "name": "InvalidMerkleRoot",
          "value": 205
        },
        {
          "doc": "",
          "name": "InvalidAudience",
          "value": 206
        },
        {
          "doc": "",
          "name": "TokenTransferMismatch",
          "value": 207
        },
        {
          "doc": "",
          "name": "MerkleRootAlreadyUsed",
          "value": 208
        },
        {
          "doc": "",
          "name": "InvalidDeadline",
          "value": 209
        },
        {
          "doc": "",
          "name": "InvalidCampaignMode",
          "value": 210
        }
      ]
    }
  },
