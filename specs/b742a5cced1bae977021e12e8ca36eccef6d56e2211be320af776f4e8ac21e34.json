    "function_v0": {
      "doc": "Runs one flash-loan-financed arb route atomically. Only the configured\\nsubmitter may call. Returns realized profit in `loan_asset` raw units.\\n\\nTwo-contract flow (avoids Soroban's re-entry prohibition): arm the receiver\\n(sub-call returns \\xe2\\x86\\x92 receiver off-stack) \\xe2\\x86\\x92 approve the pool \\xe2\\x86\\x92 `flash_loan`\\n(pool calls the now-off-stack receiver's `exec_op`, a fresh invocation) \\xe2\\x86\\x92\\ndisarm (proves the callback ran) \\xe2\\x86\\x92 assert profit on the real balance delta.",
      "name": "execute",
      "inputs": [
        {
          "doc": "",
          "name": "blend_pool",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "loan_asset",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "loan_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "legs",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Leg"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "min_profit",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "deadline_ledger",
          "type_": "u32"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
