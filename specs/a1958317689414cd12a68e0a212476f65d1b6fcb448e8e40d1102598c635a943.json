    "function_v0": {
      "doc": "Register a verification key for a circuit.\\nAdmin-gated. Asserts gamma \\xe2\\x89\\xa0 delta (prevents Veil Cash / FoomCash forgery bug).",
      "name": "set_vk",
      "inputs": [
        {
          "doc": "",
          "name": "circuit_id",
          "type_": {
            "udt": {
              "name": "CircuitId"
            }
          }
        },
        {
          "doc": "",
          "name": "vk",
