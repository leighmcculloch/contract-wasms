          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Verify a Groth16 proof against registered VK for the given circuit.\\n\\nUses native BN254 host functions via `env.crypto().bn254()`:\\n- `g1_mul` for scalar multiplication\\n- `g1_add` for point addition\\n- `Neg` trait on `Bn254G1Affine` for point negation\\n- `pairing_check` for the final verification equation\\n\\nThe Groth16 verification equation:\\ne(A, B) \\xc2\\xb7 e(-\\xce\\xb1, \\xce\\xb2) \\xc2\\xb7 e(-vk_x, \\xce\\xb3) \\xc2\\xb7 e(-C, \\xce\\xb4) == 1\\n\\nwhere vk_x = IC[0] + \\xce\\xa3(public_input[i] \\xc2\\xb7 IC[i+1])",
      "name": "verify",
      "inputs": [
        {
          "doc": "",
          "name": "circuit_id",
          "type_": {
            "udt": {
              "name": "CircuitId"
            }
          }
        },
        {
          "doc": "",
          "name": "proof",
          "type_": {
            "udt": {
              "name": "Groth16Proof"
            }
          }
        },
        {
          "doc": "",
          "name": "public_inputs",
          "type_": {
            "vec": {
              "element_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bool",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Upgrade the contract's WASM code in place (admin-gated).\\n\\nSwaps the code this same address runs while keeping all stored state\\n(admin + every registered VK). Without this, a verifier bug fix would\\nrequire a fresh deploy and re-registration of every circuit's VK.",
      "name": "upgrade",
      "inputs": [
        {
          "doc": "",
          "name": "new_wasm_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
