  {
    "function_v0": {
      "doc": "Mint a soulbound identity NFT.\\n\\nRequirements:\\n- `to` must have a verified credential in age_verifier\\n- `to` must not already have a token (one per address)\\n- `tier`: 0 = Basic ($10), 1 = Premium ($25), 2 = Rare ($100)\\n- `avatar_uri`: IPFS or HTTPS URI pointing to the avatar image\\n\\nThe tier fee is forwarded directly to the treasury (same as age_verifier model).",
      "name": "mint",
      "inputs": [
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "tier",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "avatar_uri",
          "type_": "string"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "SoulboundNftError"
              }
            }
          }
        }
      ]
    }
  },
