  {
    "udt_struct_v0": {
      "doc": "Result of a find operation in the sparse Merkle tree",
      "lib": "",
      "name": "FindResult",
      "fields": [
        {
          "doc": "Whether the key was found in the tree",
          "name": "found",
          "type_": "bool"
        },
        {
          "doc": "Value associated with the key (if found), zero otherwise",
          "name": "found_value",
          "type_": "u256"
        },
        {
          "doc": "True if the path ended at an empty branch, false if collision with\\nexisting leaf",
          "name": "is_old0",
          "type_": "bool"
        },
        {
          "doc": "Key at the collision point",
          "name": "not_found_key",
          "type_": "u256"
        },
        {
          "doc": "Value at the collision point",
          "name": "not_found_value",
          "type_": "u256"
        },
        {
          "doc": "Sibling hashes along the path from root to leaf",
          "name": "siblings",
          "type_": {
            "vec": {
              "element_type": "u256"
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Find a key in the tree\\n\\nPublic entry point for searching the tree. Returns comprehensive\\ninformation about the key including whether it exists, its value,\\nand the Merkle path siblings required for proof generation.",
      "name": "find_key",
      "inputs": [
        {
          "doc": "",
          "name": "key",
          "type_": "u256"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "udt": {
                "name": "FindResult"
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Get the current root of the tree\\n\\nReturns the root hash of the Sparse Merkle tree.",
      "name": "get_root",
      "inputs": [],
