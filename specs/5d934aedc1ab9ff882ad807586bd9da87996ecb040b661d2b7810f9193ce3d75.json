            "ok_type": "u256",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Delete a key from the tree\\n\\nRemoves a leaf from the Sparse Merkle tree, handling both sparse\\nbranches (single child) and mixed branches (two populated children).\\nWhen a leaf is deleted, its sibling may be promoted to replace the\\nparent node, collapsing the tree structure. Requires admin\\nauthorization.",
      "name": "delete_leaf",
      "inputs": [
        {
          "doc": "",
          "name": "key",
          "type_": "u256"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Insert a new key-value pair into the tree\\n\\nAdds a new leaf to the Sparse Merkle tree, building any missing\\nintermediate nodes. Handles collision cases where a new key shares a\\npath prefix with an existing leaf by extending the tree depth.\\nRequires admin authorization.",
      "name": "insert_leaf",
      "inputs": [
        {
          "doc": "",
          "name": "key",
          "type_": "u256"
        },
        {
          "doc": "",
          "name": "value",
          "type_": "u256"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Update a key-value pair in the tree\\n\\nChanges the value associated with an existing key. Recomputes all nodes\\nalong the path from the leaf to the root, removing old nodes and\\ncreating new ones. Requires admin authorization.",
      "name": "update_leaf",
      "inputs": [
        {
          "doc": "",
          "name": "key",
          "type_": "u256"
        },
        {
          "doc": "",
          "name": "new_value",
          "type_": "u256"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
