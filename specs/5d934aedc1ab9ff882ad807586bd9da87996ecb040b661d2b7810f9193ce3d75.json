  {
    "function_v0": {
      "doc": "Verify non-membership proof for a key\\n\\nVerifies that a key is NOT in the tree by checking the provided Merkle\\nproof. The proof includes siblings along the path and collision\\ninformation (not_found_key/value at the leaf). Reconstructs the root\\nfrom the proof and compares it with the stored root.",
      "name": "verify_non_membership",
      "inputs": [
        {
          "doc": "",
          "name": "key",
          "type_": "u256"
        },
        {
          "doc": "",
          "name": "siblings",
          "type_": {
            "vec": {
              "element_type": "u256"
            }
          }
        },
        {
          "doc": "",
          "name": "not_found_key",
          "type_": "u256"
        },
        {
          "doc": "",
          "name": "not_found_value",
          "type_": "u256"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bool",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "udt_error_enum_v0": {
      "doc": "Errors that can occur during Groth16 proof verification.",
      "lib": "",
      "name": "Groth16Error",
      "cases": [
        {
          "doc": "The pairing product did not equal identity.",
          "name": "InvalidProof",
          "value": 0
        },
        {
          "doc": "The public inputs length does not match the verification key.",
          "name": "MalformedPublicInputs",
          "value": 1
        },
        {
          "doc": "The proof bytes are malformed.",
          "name": "MalformedProof",
          "value": 2
        }
      ]
    }
  },
