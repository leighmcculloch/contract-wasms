[
  {
    "udt_error_enum_v0": {
      "doc": "Contract error types for the ASP non-membership sparse Merkle tree",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "Caller is not authorized to perform this operation",
          "name": "NotAuthorized",
          "value": 1
        },
        {
          "doc": "Key was not found in the tree",
          "name": "KeyNotFound",
          "value": 2
        },
        {
          "doc": "Key already exists in the tree",
          "name": "KeyAlreadyExists",
          "value": 3
        },
        {
          "doc": "Non-membership proof verification failed",
          "name": "InvalidProof",
          "value": 4
        },
        {
          "doc": "The contract has not been initialized yet",
          "name": "NotInitialized",
          "value": 5
        },
        {
          "doc": "Arithmetic overflow occurred",
          "name": "Overflow",
          "value": 6
        },
        {
          "doc": "Field input is outside the BN254 scalar field",
          "name": "InvalidFieldElement",
          "value": 7
        }
      ]
    }
  },
  {
