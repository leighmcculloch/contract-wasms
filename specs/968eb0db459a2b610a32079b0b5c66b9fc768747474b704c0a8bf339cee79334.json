  {
    "function_v0": {
      "doc": "Atomic constructor \\xe2\\x80\\x94 runs exactly once, at deploy: pin both verifying keys and\\nthe pooled asset, and seed the empty incremental tree (frontier = zero subtrees,\\nroot = the empty-tree root).\\n\\nH1: this is a `__constructor` rather than a separate `init` call, so there is no\\npost-deploy window in which an attacker could front-run initialization and bind a\\nmalicious verifying key (which would accept forged proofs and drain the pool).\\nVerifying keys and the asset are fixed in the same transaction that creates the\\ncontract, and cannot be changed afterward.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "vk_shield",
          "type_": {
            "udt": {
              "name": "VerifyingKey"
            }
          }
        },
        {
          "doc": "",
          "name": "vk_withdraw",
          "type_": {
            "udt": {
              "name": "VerifyingKey"
            }
          }
        },
        {
          "doc": "",
          "name": "vk_transfer",
          "type_": {
            "udt": {
              "name": "VerifyingKey"
            }
          }
        },
        {
          "doc": "",
          "name": "vk_claim",
          "type_": {
            "udt": {
              "name": "VerifyingKey"
            }
          }
        }
      ],
      "outputs": []
    }
  },
