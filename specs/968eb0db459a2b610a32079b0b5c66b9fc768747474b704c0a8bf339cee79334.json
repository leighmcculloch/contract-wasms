    "function_v0": {
      "doc": "Shield `amount` of the pooled asset under `commitment`.\\n\\nVerifies the shield proof binds `commitment` to the PUBLIC `amount`, pulls the\\nfunds from `depositor`, inserts the commitment into the tree, and emits\\nDepositCreated. Public inputs (pinned order): [commitment, amount].",
      "name": "shield",
      "inputs": [
        {
          "doc": "",
          "name": "proof",
          "type_": {
            "udt": {
              "name": "Proof"
            }
          }
        },
