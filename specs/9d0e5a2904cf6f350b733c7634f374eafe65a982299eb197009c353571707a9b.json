  {
    "function_v0": {
      "doc": "Donate `amount` of the campaign's token toward `campaign_id`, locking it in\\nthe contract. Tracks the campaign total and the donor's lifetime amount;\\nincrements the distinct-donor count on a wallet's first gift. Returns the\\nnew lifetime raised total.\\n\\nAuth: requires the donor's signature. The same authorization covers the\\ninner SAC `transfer(donor -> contract)`.",
      "name": "donate",
      "inputs": [
        {
          "doc": "",
          "name": "donor",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "campaign_id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Disburse `amount` of the held balance to `recipient`, appending an\\nimmutable `SpendRecord` (recipient, amount, `memo` = sha256 of the payout\\nnote, ledger sequence) to the campaign's on-chain spend ledger. Returns\\nthe index of the new ledger entry.\\n\\nAuth: requires the campaign organizer's signature; cannot exceed the held\\nbalance.",
      "name": "disburse",
      "inputs": [
        {
          "doc": "",
          "name": "organizer",
          "type_": "address"
        },
        {
