  {
    "udt_union_v0": {
      "doc": "Storage keys. `Campaign`, `Donor` and `Spends` live in *persistent* storage\\n(they must outlive the contract instance so funds and the audit trail are\\nnever stranded); `Admin`/`Token`/`TotalRaised` live in *instance* storage so\\nthey share the instance TTL.",
      "lib": "",
      "name": "DataKey",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "Admin"
          }
        },
        {
          "void_v0": {
            "doc": "Default token (the XLM Stellar Asset Contract) recorded at init.",
            "name": "Token"
          }
        },
        {
          "void_v0": {
            "doc": "Running total of all minor units ever donated across every campaign.",
            "name": "TotalRaised"
          }
        },
        {
          "tuple_v0": {
            "doc": "campaign_id -> Campaign",
            "name": "Campaign",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "(campaign_id, donor) -> i128 lifetime donated by that wallet.",
            "name": "Donor",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
                }
              },
              "address"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "campaign_id -> Vec<SpendRecord> (append-only on-chain spend ledger).",
            "name": "Spends",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
                }
              }
            ]
          }
        }
      ]
    }
  },
  {
    "udt_enum_v0": {
      "doc": "Lifecycle of a campaign.\\nA campaign starts `Active`; the organizer may `Closed` it once the relief\\nwork is done. Closing only blocks *new donations* \\xe2\\x80\\x94 the organizer can still\\ndisburse the remaining held balance to recipients.",
      "lib": "",
      "name": "CampaignStatus",
      "cases": [
        {
          "doc": "",
          "name": "Active",
          "value": 0
        },
        {
          "doc": "",
          "name": "Closed",
          "value": 1
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A single fundraising campaign, keyed in storage by a 32-byte `campaign_id`\\n(the app passes `sha256(<campaign UUID>)`).\\n\\nThe contract custodies exactly `balance` minor units of `token` for this\\ncampaign. `raised` is the lifetime sum ever donated (never decremented), so\\nthe UI can always show \"total raised\". `disbursed` + `balance` == `raised`.",
      "lib": "",
      "name": "Campaign",
      "fields": [
        {
          "doc": "Funds currently held in the contract for this campaign (raised - disbursed).",
          "name": "balance",
          "type_": "i128"
        },
        {
          "doc": "Lifetime total ever paid out to recipients.",
          "name": "disbursed",
          "type_": "i128"
        },
        {
          "doc": "Number of distinct donor wallets that have funded this campaign.",
          "name": "donors",
          "type_": "u32"
        },
        {
          "doc": "Fundraising target, in the token's minor units (7 dp).",
          "name": "goal",
          "type_": "i128"
        },
        {
          "doc": "The organizer who opened the campaign; the only address allowed to disburse.",
          "name": "organizer",
          "type_": "address"
        },
        {
          "doc": "Lifetime total ever donated (monotonic; survives disbursements).",
          "name": "raised",
          "type_": "i128"
        },
        {
          "doc": "Number of disbursements recorded in the on-chain spend ledger.",
          "name": "spends",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "status",
          "type_": {
            "udt": {
              "name": "CampaignStatus"
            }
          }
        },
        {
          "doc": "Stellar Asset Contract (SAC) address of the campaign asset (XLM SAC by default).",
          "name": "token",
          "type_": "address"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "One immutable entry in a campaign's on-chain spend ledger. Appended on every\\n`disburse` and never mutated \\xe2\\x80\\x94 this is the transparency record auditors read.",
      "lib": "",
      "name": "SpendRecord",
      "fields": [
        {
          "doc": "Amount paid out, in the token's minor units (7 dp).",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "Ledger sequence at which the payout was recorded (on-chain timestamp).",
          "name": "ledger",
          "type_": "u32"
        },
        {
          "doc": "`sha256(<payout description>)` \\xe2\\x80\\x94 ties the on-chain entry to its off-chain note.",
          "name": "memo",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "Wallet the funds were paid to.",
          "name": "recipient",
          "type_": "address"
        }
      ]
    }
  },
