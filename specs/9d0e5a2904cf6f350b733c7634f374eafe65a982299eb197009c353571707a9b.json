          "name": "memo",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u32",
            "error_type": "error"
          }
        }
      ]
    }
  },
