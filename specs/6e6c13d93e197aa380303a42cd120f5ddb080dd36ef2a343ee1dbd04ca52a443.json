          "type_": "u32"
        },
        {
          "doc": "",
          "name": "oracle_max_deviation_bps",
          "type_": {
            "option": {
              "value_type": "u32"
            }
          }
        },
        {
          "doc": "Per-policy oracle bounds. `None` on any field uses the wasm default.\\nOverrides may only TIGHTEN - a widening value is refused at install.\\n\\nCarried as scalars rather than the `Option<OracleParams>` the ABI\\nnote describes: soroban-sdk 27 cannot derive the ScVal conversion for\\nan `Option<T>` where T is a `#[contracttype]` struct, so that shape\\ncompiles for wasm but breaks every test build. The wire content is\\nthe same set of values.",
          "name": "oracle_max_staleness_seconds",
          "type_": {
            "option": {
              "value_type": "u32"
            }
          }
        },
        {
          "doc": "Cross-feed divergence bound override (Track B). Tighten-only against\\n`oracle::DEFAULT_MAX_CROSS_FEED_DEVIATION_BPS`. Field name kept\\nunder 30 chars for the soroban-sdk contracttype limit.",
          "name": "oracle_max_xfeed_dev_bps",
          "type_": {
            "option": {
              "value_type": "u32"
            }
          }
        },
        {
          "doc": "",
          "name": "predicate",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "predicate_hash",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ]
    }
  },
