    "udt_struct_v0": {
      "doc": "Frozen wire ABI for `Policy::install`'s `AccountParams`.\\n\\n`predicate` is the raw canonical ScVal XDR \\xe2\\x80\\x94 `ScVal::Vec([symbol, ...])`\\nfor the root \\xe2\\x80\\x94 that the encoder emits. The host parses it on receipt; the\\ncontract never touches `stellar-xdr`.",
      "lib": "",
