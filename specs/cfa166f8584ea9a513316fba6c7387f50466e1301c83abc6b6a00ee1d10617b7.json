            "vec": {
              "element_type": "u32"
            }
          }
        },
        {
          "doc": "Global registry IDs for each signer, positionally aligned with\\n`signers`.",
          "name": "signer_ids",
          "type_": {
            "vec": {
              "element_type": "u32"
            }
          }
        },
        {
          "doc": "List of signers authorized by this rule.",
          "name": "signers",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Signer"
                }
              }
            }
          }
        },
        {
          "doc": "Optional expiration ledger sequence for the rule.",
          "name": "valid_until",
          "type_": {
            "option": {
              "value_type": "u32"
            }
          }
        }
      ]
    }
  },
