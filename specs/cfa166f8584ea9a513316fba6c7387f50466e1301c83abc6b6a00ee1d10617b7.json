        {
          "doc": "List of policy contracts that must be satisfied.",
          "name": "policies",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "Global registry IDs for each policy, positionally aligned with\\n`policies`.",
