  {
    "function_v0": {
      "doc": "Bring storage written by an older build into this one's shape, so a\\ncode swap lands as `upgrade() \\xe2\\x86\\x92 migrate(from)` with no bespoke\\nceremony per schema bump.\\n\\n`#[contracttype]` encodes a struct as a map keyed by field name, so\\nold bytes decode only if the field SET matches exactly \\xe2\\x80\\x94 a gained\\nfield makes the host trap, a removed one too. `ensure_schema` keeps\\nevery other entrypoint shut until this has run, which is why the\\ncontract fails closed rather than half-working after a code swap.\\n\\nThe reshaping is generic: read the stored value as a raw\\n`Map<Symbol, Val>`, drop keys this build no longer has, fill keys it\\nhas gained from `reference`, and write the result back typed. The\\nonly thing a future schema bump must touch is `reference` \\xe2\\x80\\x94 it is\\nboth the field list and the defaults for anything new.",
      "name": "migrate",
      "inputs": [
        {
          "doc": "",
          "name": "creator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "from_version",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "reference",
          "type_": {
            "udt": {
              "name": "Policy"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
