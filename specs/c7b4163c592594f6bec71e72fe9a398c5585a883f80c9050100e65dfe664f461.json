  {
    "function_v0": {
      "doc": "The system (`creator`) enrolls `member` on their behalf \\xe2\\x80\\x94 the custodial\\npath. Same roster effect and admission gates as `join`, but authorised by\\nthe creator, not the member: the member never signs, so no signature can\\nexpire mid-async while a server-driven flow retries. This is how the\\nfounding owner (and any member) is added when the flow is system-driven.\\nThe platform vouches for the member's consent at the business layer.",
      "name": "enroll",
      "inputs": [
        {
          "doc": "",
          "name": "creator",
          "type_": "address"
        },
        {
