  {
    "function_v0": {
      "doc": "Sender reclaims funds from a one-off padala whose buckets went unclaimed\\npast its expiry (family no-show). Transfers the sum of still-unclaimed\\nbuckets back to the sender and marks them settled so they can't later be\\nclaimed or reclaimed again. Reverts before expiry or if nothing is left.",
      "name": "reclaim",
      "inputs": [
        {
          "doc": "",
          "name": "padala_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A prefunded recurring schedule. The sender deposits `occurrences` worth of the\\ntemplate up front; anyone may call `execute_due` once each interval elapses,\\nwhich mints a fresh Padala from the already-escrowed funds (no per-run sender\\nsignature needed \\xe2\\x80\\x94 the whole point of \"recurring\").",
      "lib": "",
      "name": "Recurring",
      "fields": [
        {
          "doc": "",
          "name": "active",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "interval_secs",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "next_run",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "per_run_total",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "prefunded",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "remaining",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "sender",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "template",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "BucketInput"
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A merchant's on-chain track record, accrued one claim at a time. Lets the\\nsender/family see that a whitelisted merchant (e.g. a school) has actually\\nserved real claims before trusting a restricted bucket to it.",
