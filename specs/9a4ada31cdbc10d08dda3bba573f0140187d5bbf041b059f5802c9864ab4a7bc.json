[
  {
    "udt_error_enum_v0": {
      "doc": "",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "Constructor never ran (no signers stored). Code kept from v0.1.",
          "name": "NotInitialized",
          "value": 1
        },
        {
          "doc": "clientDataJSON.challenge != base64url(signature_payload). Kept from v0.1.",
          "name": "ChallengeMismatch",
          "value": 2
        },
        {
          "doc": "signature.public_key is not an enrolled signer.",
          "name": "UnknownSigner",
          "value": 3
        },
        {
          "doc": "add_signer with a key that is already enrolled.",
          "name": "SignerAlreadyExists",
          "value": 4
        },
        {
          "doc": "remove_signer would leave the account with zero signers.",
          "name": "LastSignerRemoval",
          "value": 5
        },
        {
          "doc": "add_signer beyond MAX_SIGNERS.",
          "name": "SignerLimitReached",
          "value": 6
        },
        {
          "doc": "clientDataJSON exceeds CLIENT_DATA_MAX_LEN.",
          "name": "ClientDataTooLong",
          "value": 7
        },
        {
          "doc": "clientDataJSON is not parseable JSON with challenge + type.",
          "name": "ClientDataParseError",
          "value": 8
        },
        {
          "doc": "clientDataJSON.type is not \"webauthn.get\".",
          "name": "WrongCeremonyType",
          "value": 9
        },
        {
          "doc": "authenticatorData shorter than AUTHENTICATOR_DATA_MIN_LEN.",
          "name": "AuthDataTooShort",
          "value": 10
        },
        {
          "doc": "User-Present flag not set.",
          "name": "UserPresentFlagMissing",
          "value": 11
        },
        {
          "doc": "User-Verified flag not set (biometric / PIN required).",
          "name": "UserVerifiedFlagMissing",
          "value": 12
        },
        {
          "doc": "Backup State set without Backup Eligibility (invalid per WebAuthn).",
          "name": "BackupStateInvalid",
          "value": 13
        }
      ]
    }
  },
