  {
    "function_v0": {
      "doc": "Issue a soulbound credential to a player for completing `subject` at\\n`cefr_level` with `score` (0-100). Admin-only: in this MVP the admin\\nacts as the trusted issuer on behalf of WordScrambleContract, since\\nthe two contracts aren't wired together yet. Panics if score is below\\nthe pass threshold, so a credential can never be issued for a failing\\nor borderline result.",
      "name": "issue_credential",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "player",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "subject",
          "type_": "symbol"
        },
        {
          "doc": "",
          "name": "cefr_level",
          "type_": "symbol"
        },
        {
          "doc": "",
          "name": "score",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "bytes_n": {
            "n": 32
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Publicly verify a single credential by ID. Anyone can call this via\\nthe public RPC without needing to trust the issuing platform.",
      "name": "verify_credential",
