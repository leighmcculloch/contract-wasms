  {
    "function_v0": {
      "doc": "Credentials are soulbound \\xe2\\x80\\x94 they can never move between wallets.\\nAlways rejects, on purpose: this is what makes a credential prove\\n*this specific player* earned it, instead of just being a tradeable\\nbadge someone else could buy.",
      "name": "transfer",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "id",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bool",
            "error_type": {
              "udt": {
                "name": "ContractError"
              }
            }
          }
        }
      ]
    }
  },
