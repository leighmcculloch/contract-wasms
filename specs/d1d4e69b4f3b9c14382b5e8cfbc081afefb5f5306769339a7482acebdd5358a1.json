  {
    "function_v0": {
      "doc": "- `admin`: account which will: upgrade this Registry itself; add, set, or remove `manager`\\n- `manager`: optional. If set, makes this a *managed* registry, meaning `publish`, `register_contract`, & `deploy` must be approved by the manager before caller's account is considered trusted for that contract/wasm name.\\n- `root`: if None, this registry is the root registry \\xe2\\x80\\x94 it has no namespace, other registries (like the `unverified` one) are registered in it, and the constructor auto-deploys the `unverified` registry. If Some, this is a subregistry that defers to the given root for resolving sibling subregistry names during cross-registry deploys.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "manager",
          "type_": {
            "option": {
              "value_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "root",
          "type_": {
            "option": {
              "value_type": "address"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
