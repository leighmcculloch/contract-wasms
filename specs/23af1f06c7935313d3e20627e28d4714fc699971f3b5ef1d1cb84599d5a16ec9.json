    "function_v0": {
      "doc": "Single-asset deposit into a Soroswap LP pool.\\n\\nAtomic flow:\\n1. Pull token_in from caller\\n2. Split 50/50: swap half for token_pair via Soroswap router\\n3. Add liquidity to target pool via Soroswap router\\n4. Mint dfTokens proportional to LP tokens received\\n5. Update positions map\\n\\nIf any step fails, the entire transaction reverts \\xe2\\x80\\x94 user keeps their tokens.",
      "name": "deposit_single_asset",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "target_pool",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "min_lp_out",
          "type_": "i128"
        }
      ],
      "outputs": [
