    "function_v0": {
      "doc": "Safe Mode deposit: routes single-token deposit into RAW$ AMM via C2C.\\n\\nAtomic flow:\\n1. Pull token_in from caller\\n2. Query AMM for token_a and token_b addresses\\n3. Split 50/50: swap half for token_pair via AMM exchange()\\n4. Add liquidity to AMM with both sides balanced via add_liquidity()\\n5. Mint dfTokens proportional to LP shares received\\n6. Update vault positions map\\n\\nIf any step fails, the entire transaction reverts \\xe2\\x80\\x94 user keeps their tokens.",
      "name": "deposit_safe_mode",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_shares",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
