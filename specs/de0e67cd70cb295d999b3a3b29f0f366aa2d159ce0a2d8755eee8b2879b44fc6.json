    "function_v0": {
      "doc": "`(pt, sy)` this contract custodies beyond what backs the curve \\xe2\\x80\\x94\\ndonations, and any token sent here by mistake. Always >= 0 in a healthy\\nmarket; a negative value would mean custody is short of the reserves the\\ncurve believes it has, so it is surfaced rather than saturated.",
      "name": "untracked_balance",
      "inputs": [],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "tuple": {
                "value_types": [
                  "i128",
                  "i128"
                ]
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "`(pt_out, sy_used)` for an exact-SY-in PT buy. `sy_used <= sy_in`, and\\n`sy_used` is what the swap will actually debit \\xe2\\x80\\x94 the solver is bounded by\\nthe curve, so past the saturation point extra input buys nothing and is\\nsimply not charged. Callers should surface `sy_used` and warn when it is\\nmaterially below `sy_in`, because that means the market cannot absorb the\\nrequested size.",
      "name": "quote_sy_for_pt_cost",
      "inputs": [
        {
          "doc": "",
          "name": "sy_in",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "tuple": {
                "value_types": [
                  "i128",
                  "i128"
                ]
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "`(yt_out, sy_used)` for an exact-SY-in YT buy. Same contract as\\n`quote_sy_for_pt_cost`: `sy_used` is the shortfall the pool cannot fund\\nfrom selling the PT leg into its own curve, and is exactly what the swap\\nwill debit.",
      "name": "quote_sy_for_yt_cost",
