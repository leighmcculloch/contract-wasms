    "function_v0": {
      "doc": "Verify an LE-ECDSA signed Pyth Lazer update.\\n\\nParses the envelope, recovers the signer's public key, checks it against\\ntrusted signers, validates expiry, and returns the verified payload bytes.\\n\\nVerification is stateless: it proves the payload was signed by a\\ncurrently trusted signer, but does not prevent replay of an update or\\norder updates by arrival. Callers must deduplicate updates and enforce\\nfreshness using the `timestamp` field of the verified payload (and,\\nwhere relevant, the per-feed `feed_update_timestamp`) \\xe2\\x80\\x94 never the\\nenvelope bytes, the signature, or a hash of either.",
      "name": "verify_update",
      "inputs": [
        {
          "doc": "",
          "name": "data",
          "type_": "bytes"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bytes",
            "error_type": {
              "udt": {
                "name": "ContractError"
              }
            }
          }
        }
      ]
    }
  },
