          "name": "min_cr",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "liq_cr",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "liq_penalty",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "stab_fee_bps",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "debt_ceiling",
          "type_": "i128"
        }
      ],
