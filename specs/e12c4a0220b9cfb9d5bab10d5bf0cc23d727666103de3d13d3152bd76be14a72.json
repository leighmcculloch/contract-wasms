  {
    "udt_enum_v0": {
      "doc": "Lifecycle of an invoice escrow. An escrow is created `Funded` when the client\\ndeposits; it becomes `Released` once the freelancer is paid out, or\\n`Refunded` if the client reclaims the deposit before release.",
      "lib": "",
      "name": "EscrowStatus",
      "cases": [
        {
          "doc": "",
          "name": "Funded",
          "value": 0
        },
        {
          "doc": "",
          "name": "Released",
          "value": 1
        },
        {
          "doc": "",
          "name": "Refunded",
          "value": 2
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A single invoice escrow. The contract custodies `amount` of `token` between\\n`deposit` (client funds it) and the terminal `release` (pay the freelancer)\\nor `refund` (return to the client). Funds can only ever move to one of those\\ntwo pre-committed addresses \\xe2\\x80\\x94 the admin can choose *when*, never *where*.",
      "lib": "",
      "name": "Escrow",
      "fields": [
        {
          "doc": "Escrowed amount in the token's minor units (stroops for XLM; 7 decimals).",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "Funder; the address the deposit is pulled from and a refund returns to.",
          "name": "client",
          "type_": "address"
        },
        {
          "doc": "Beneficiary; the only address a release can pay.",
          "name": "freelancer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "status",
          "type_": {
            "udt": {
              "name": "EscrowStatus"
            }
          }
        },
        {
          "doc": "Stellar Asset Contract (SAC) address of the escrowed asset (native XLM by default).",
          "name": "token",
          "type_": "address"
        }
