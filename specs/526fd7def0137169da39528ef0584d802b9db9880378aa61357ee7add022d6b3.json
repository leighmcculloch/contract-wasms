  {
    "function_v0": {
      "doc": "Execute a multi-venue routed swap for `user`.\\n\\nVerifies: segments are positive and sum to total_amount_in; every\\nvenue exists; net output (after the 0.5 bps protocol fee on the\\nTOTAL output) meets min_total_out \\xe2\\x80\\x94 otherwise the whole tx reverts.",
      "name": "execute_route",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "total_amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_total_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "segments",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "RouteSegment"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "RouterError"
              }
            }
          }
        }
      ]
    }
  },
