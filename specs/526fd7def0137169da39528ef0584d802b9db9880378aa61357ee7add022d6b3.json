  {
    "function_v0": {
      "doc": "PERMISSIONLESS keeper entry point: route a timer-expired SwapBook\\norder through DEX venues and settle the maker \\xe2\\x80\\x94 all in one invocation.\\n\\n1. Claims the order from SwapBook (escrow moves to this contract;\\nSwapBook authorizes us via invoker auth and returns the maker's\\non-chain price floor `min_out`).\\n2. Executes the provided route segments.\\n3. Deducts the protocol fee, enforces net proceeds >= min_out,\\nand pays the maker.\\n\\nAnyone may call this \\xe2\\x80\\x94 a caller gains nothing (proceeds always go to\\nthe maker) and a bad route simply reverts, leaving the order claimable\\nagain... (revert restores the order's Open state too).",
      "name": "route_expired_order",
      "inputs": [
        {
          "doc": "",
          "name": "order_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "segments",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "RouteSegment"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "RouterError"
              }
            }
          }
        }
      ]
    }
  }
