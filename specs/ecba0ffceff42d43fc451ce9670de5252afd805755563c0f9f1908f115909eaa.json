            "name": "Voted",
            "type_": [
              "u64",
              "address"
            ]
          }
        }
      ]
    }
  },
  {
    "udt_enum_v0": {
      "doc": "Lifecycle of a funding proposal.\\n\\n- `Active`   \\xe2\\x80\\x94 open for voting.\\n- `Passed`   \\xe2\\x80\\x94 reached a strict majority of members in favour, but the\\ntreasury balance was not yet enough to pay out; awaits funds + `disburse`.\\n- `Funded`   \\xe2\\x80\\x94 the requested amount was transferred to the recipient.\\n- `Rejected` \\xe2\\x80\\x94 closed without funding (reserved for admin/extension use).",
      "lib": "",
      "name": "ProposalStatus",
      "cases": [
        {
          "doc": "",
          "name": "Active",
          "value": 0
        },
        {
          "doc": "",
          "name": "Passed",
          "value": 1
        },
        {
          "doc": "",
          "name": "Funded",
          "value": 2
        },
        {
          "doc": "",
          "name": "Rejected",
          "value": 3
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A community funding request, tracked entirely on-chain. Vote tallies and the\\ndisbursement decision live here so no backend can fake an outcome.",
      "lib": "",
      "name": "Proposal",
      "fields": [
        {
          "doc": "Requested amount, in the token's minor units (XLM SAC = 7 decimals).",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "Member who opened the proposal.",
          "name": "proposer",
          "type_": "address"
        },
        {
          "doc": "Address that receives the grant when the proposal is funded.",
          "name": "recipient",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "status",
          "type_": {
            "udt": {
              "name": "ProposalStatus"
            }
          }
        },
        {
          "doc": "No votes.",
          "name": "votes_no",
          "type_": "u32"
        },
        {
          "doc": "Yes votes (one per distinct voting member).",
          "name": "votes_yes",
          "type_": "u32"
        }
      ]
    }
  },
