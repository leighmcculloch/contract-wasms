          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "TotalReleased"
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "ProposalCounter"
          }
        },
        {
          "tuple_v0": {
            "doc": "member address -> cumulative contribution (i128, minor units)",
            "name": "Member",
            "type_": [
