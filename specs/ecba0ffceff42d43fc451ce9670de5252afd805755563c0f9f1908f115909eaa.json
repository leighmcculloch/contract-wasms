  {
    "udt_union_v0": {
      "doc": "Storage keys.\\n\\n`Admin`, `Token`, `Paused`, the running counters and `ProposalCounter` live\\nin *instance* storage (they share the contract instance TTL). Per-member\\nbalances, proposals and vote markers live in *persistent* storage so they\\noutlive the instance and can never expire out from under a pending payout.",
      "lib": "",
      "name": "DataKey",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "Admin"
          }
        },
        {
