  {
    "function_v0": {
      "doc": "Contribute `amount` of XLM into the community fund. Pulls the deposit into\\nthe contract's custody and tracks the member's cumulative stake. Returns\\nthe member's new total contribution.\\n\\nAuth: the member's signature also authorizes the inner SAC transfer.",
      "name": "contribute",
      "inputs": [
        {
          "doc": "",
          "name": "member",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Open a funding proposal asking for `amount` to be sent to `recipient`.\\nReturns the new proposal id (1-based).",
      "name": "create_proposal",
      "inputs": [
        {
          "doc": "",
          "name": "proposer",
          "type_": "address"
        },
        {
          "doc": "",
