            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Cast a vote on a proposal. One vote per member per proposal. When the\\nyes-votes cross a strict majority of members (`2 * yes > member_count`)\\nand the treasury holds enough, the contract disburses to the recipient in\\nthe same call. Returns the proposal's resulting status.\\n\\nAuth: the voter's signature.",
      "name": "vote",
      "inputs": [
        {
          "doc": "",
          "name": "voter",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "proposal_id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "in_favor",
          "type_": "bool"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "udt": {
                "name": "ProposalStatus"
              }
            },
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Complete a proposal that already won its vote (`Passed`) once the treasury\\nhas the funds. Idempotent guard against double-pay. Admin-gated fallback\\nfor the auto-disbursement in `vote`.",
      "name": "disburse",
      "inputs": [
        {
          "doc": "",
          "name": "proposal_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
