  {
    "function_v0": {
      "doc": "Open a new split bill and return its id.\\n\\nAuth: the **admin** signs. The app opens bills on behalf of creators (a\\ncreator only supplies a receiving address, they need not have a wallet\\nconnected). No funds move here \\xe2\\x80\\x94 money only flows on `pay_share`.",
      "name": "open_bill",
      "inputs": [
        {
          "doc": "",
          "name": "creator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "total_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "num_shares",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "deadline",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u32",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Pay one participant's `amount` into the bill's escrow.\\n\\nAuth: the **payer** signs (the same authorization covers the inner SAC\\n`transfer(payer -> contract)`). When this payment completes the bill's\\nfunding, the whole pot is released to the creator in the same call.\\nReturns the bill's funded amount after this contribution.",
      "name": "pay_share",
      "inputs": [
        {
          "doc": "",
          "name": "bill_id",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "payer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Explicitly release a fully-funded bill to its creator. Normally\\n`pay_share` releases automatically; this is a safety valve.",
      "name": "release",
      "inputs": [
        {
          "doc": "",
          "name": "bill_id",
