  {
    "udt_enum_v0": {
      "doc": "Lifecycle of a split bill. A bill is created `Open`; it becomes `Settled`\\nonce it is fully funded and the pooled total is released to the creator, or\\n`Cancelled` if the creator/admin abandons it (which opens the refund path\\nso every contributor can reclaim what they put in).",
      "lib": "",
      "name": "BillStatus",
      "cases": [
        {
          "doc": "",
          "name": "Open",
          "value": 0
        },
        {
          "doc": "",
          "name": "Settled",
          "value": 1
        },
        {
          "doc": "",
          "name": "Cancelled",
          "value": 2
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A single split-the-bill escrow. The contract custodies `funded_amount` of\\n`token` until the bill is fully funded (then it is released to `creator`) or\\nabandoned (then each contributor refunds their own share).",
      "lib": "",
      "name": "Bill",
      "fields": [
        {
          "doc": "Payout address \\xe2\\x80\\x94 receives the pooled total once fully funded.",
          "name": "creator",
          "type_": "address"
        },
        {
          "doc": "Unix timestamp (ledger time) after which the bill is abandonable: an\\nunfunded bill past this point can be refunded by its contributors.",
          "name": "deadline",
          "type_": "u64"
        },
        {
          "doc": "Sum of all contributions still held in escrow.",
          "name": "funded_amount",
          "type_": "i128"
        },
        {
          "doc": "Expected number of participant shares (informational).",
          "name": "num_shares",
          "type_": "u32"
        },
        {
          "doc": "Shares paid so far.",
          "name": "paid_shares",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "status",
          "type_": {
            "udt": {
              "name": "BillStatus"
            }
          }
        },
        {
          "doc": "Stellar Asset Contract (SAC) address of the escrowed asset (native XLM).",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "Target total in the token's minor units (stroops for XLM = 7 decimals).",
          "name": "total_amount",
          "type_": "i128"
        }
      ]
    }
  },
