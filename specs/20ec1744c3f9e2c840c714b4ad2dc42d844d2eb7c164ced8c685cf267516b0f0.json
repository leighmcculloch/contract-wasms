          "type_": "i128"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Recorded state of a registered order. Existence in persistent storage\\nimplies \"registered\"; `remaining == 0` post-registration means cancelled\\nor fully filled.\\n**Raw encoding (Solidity-compatible sentinel)**: `remaining == 0` \\xe2\\x87\\x92 never\\nregistered (Solidity `_ORDER_DOES_NOT_EXIST`); `remaining == 1` \\xe2\\x87\\x92 cancelled\\nor fully filled (Solidity `_ORDER_FILLED`); `remaining > 1` \\xe2\\x87\\x92\\n`actual_remaining = remaining - 1`. Returned as-is by `order_status_raw`.\\n**Decoded encoding**: `order_status` / `order_statuses` apply `- 1` so\\n`remaining` is already the actual figure (0 = filled or cancelled).",
      "lib": "",
      "name": "OrderStatus",
      "fields": [
        {
          "doc": "",
          "name": "filled_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "remaining",
          "type_": "i128"
        }
      ]
    }
  },
  {
    "udt_union_v0": {
      "doc": "Denomination the maker funds (or receives, on payout-side) the IBT leg\\nin. Mirrors Solidity `MakerTokenType` from PR #22. `Ibt` is the no-conversion\\npath and equals `pt.get_ibt()` (whether or not that IBT is a Spectra wrapper).",
      "lib": "",
      "name": "MakerTokenType",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "Ibt"
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "VaultShare"
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "Underlying"
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "FillOrderParams",
