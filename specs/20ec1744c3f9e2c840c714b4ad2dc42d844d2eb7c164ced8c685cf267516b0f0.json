    "function_v0": {
      "doc": "1. validate + update statuses (no pricing, no max_taking)\\n2. pull taker_input_token (caller pre-stages)\\n3. pull maker funds + convert to IBT + price (fused single loop \\xe2\\x80\\x94\\npricing uses *realized* IBT from the conversion, not a preview)\\n4. taker-side tokenisation (IBT\\xe2\\x86\\x94PT+YT) if needed\\n5. settle makers (denomination-aware on payout-side), pay fees,\\nsweep residuals to receiver",
      "name": "fill_orders",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
