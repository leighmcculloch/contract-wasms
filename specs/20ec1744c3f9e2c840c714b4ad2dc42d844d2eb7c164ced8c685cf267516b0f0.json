  {
    "udt_struct_v0": {
      "doc": "",
      "lib": "",
      "name": "Order",
      "fields": [
        {
          "doc": "Order expiry \\xe2\\x80\\x94 unix seconds. Must satisfy `now < expiry <= pt.maturity`.",
          "name": "expiry",
          "type_": "u64"
        },
        {
          "doc": "Slippage floor for the wrapper conversions, expressed as **output per\\ninput**: the minimum raw output-token amount per `1e18` raw input-token\\nunits. `0` disables the floor.\\n\\nThe engine applies it as `floor = amount * fail_safe_rate / 1e18` against\\nthe realized output of `deposit` / `redeem` (Underlying path), or passes\\nit natively as `min_shares` / `min_vault_shares` to `wrap_with_min_shares`\\n/ `unwrap_with_min_vault_shares` (VaultShare path).\\n\\nBeing raw-output-per-raw-input it carries the output token's decimals and\\nso implicitly encodes the underlying\\xe2\\x86\\x94IBT decimal gap \\xe2\\x80\\x94 set it to\\n`previewConversion(1e18)` of the order's conversion (`previewDeposit`\\nfunding, `previewRedeem` payout, wrap/unwrap preview for VaultShare). It\\nis *not* a decimal-agnostic value ratio: a gapped market holds a large\\nmarket-specific value (e.g. ~`1e30` for a value-preserving\\n6-dec-underlying / 18-dec-IBT deposit), not `~1e18`, and no decimal\\nrescaling is applied on-chain.",
          "name": "fail_safe_rate",
          "type_": "i128"
        },
        {
          "doc": "Implied APY, 18-decimal fixed-point (1e18 = 100%). Used by the pricing\\nlibrary to compute spot + fee-adjusted prices.",
          "name": "implied_rate",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "maker",
          "type_": "address"
        },
        {
          "doc": "Denomination of the IBT leg. For IBT-funding order types (`IbtForPt`,\\n`IbtForYt`) governs what the maker deposits. For IBT-payout types\\n(`PtForIbt`, `YtForIbt`) governs what the maker receives. `Ibt` is the\\npassthrough; `Underlying` and `VaultShare` route through the IBT's\\n`SpectraFungibleVaultWrapper` surface and require `pt.get_ibt()` to\\nhost that wrapper.",
          "name": "maker_token_type",
          "type_": {
            "udt": {
              "name": "MakerTokenType"
            }
          }
        },
        {
          "doc": "Total amount of the making token offered (token-decimals of the making side).",
          "name": "making_amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "order_type",
          "type_": {
            "udt": {
              "name": "OrderType"
            }
          }
        },
        {
          "doc": "PrincipalToken contract for which this order is placed.",
          "name": "pt",
          "type_": "address"
        },
        {
          "doc": "Where the maker receives the taker's payment.",
          "name": "receiver",
          "type_": "address"
        },
        {
          "doc": "Disambiguates otherwise-identical orders (same maker/pt/amount/rate)",
          "name": "salt",
          "type_": "u64"
        }
      ]
    }
  },
  {
    "udt_union_v0": {
      "doc": "Order direction. Solidity `OrderType` enum (ILimitOrderEngine.sol).\\n`#[contracttype]` unit-variant enums serialize as the variant name\\n(`Symbol`), so off-chain consumers see `\"IbtForPt\"` on the wire \\xe2\\x80\\x94 not a\\nnumeric discriminant. Cross-chain consumers must therefore match on the\\nvariant name, not on a numeric value shared with the Solidity enum.",
      "lib": "",
      "name": "OrderType",
      "cases": [
        {
          "void_v0": {
            "doc": "maker sells IBT, taker pays PT",
            "name": "IbtForPt"
          }
        },
        {
          "void_v0": {
            "doc": "maker sells PT, taker pays IBT",
            "name": "PtForIbt"
          }
        },
        {
          "void_v0": {
            "doc": "maker sells IBT, taker pays YT",
            "name": "IbtForYt"
          }
        },
        {
          "void_v0": {
            "doc": "maker sells YT, taker pays IBT",
            "name": "YtForIbt"
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Per-order fill outcome. `actual_taking` excludes the fee",
      "lib": "",
      "name": "OrderResult",
      "fields": [
        {
          "doc": "",
