  {
    "udt_struct_v0": {
      "doc": "A collateral position, and the promise it backs.\\n\\nEverything from `first_distribution_time` down is a *snapshot*, taken when\\nthe collateral was posted. It is deliberately not re-read from the splitter:\\nthe pool admin can rewrite their own schedule, and if the vault followed\\nalong, missing a payment could be undone by editing the calendar.",
      "lib": "",
      "name": "Position",
      "fields": [
        {
          "doc": "Slots the pool had already paid for when the collateral was posted, so\\nthat only payments promised *after* the deposit are measured.",
          "name": "covered_at_deposit",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "created_at",
          "type_": "u64"
        },
        {
          "doc": "Everything ever put in, including top-ups. Informational.",
          "name": "deposited",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "depositor",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "events_executed",
          "type_": "u32"
        },
        {
          "doc": "How many slices the collateral is cut into (1..=3).",
          "name": "events_total",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "first_distribution_time",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "interval_seconds",
          "type_": "u64"
        },
        {
          "doc": "Missed payments needed to unlock each liquidation event.",
          "name": "miss_threshold",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "pool",
          "type_": "address"
        },
        {
          "doc": "Still backing the promise. The depositor can take this back, on notice.",
          "name": "remaining",
          "type_": "i128"
        },
        {
          "doc": "Taken from the operator and owed to the pool's shareholders. Never\\nwithdrawable, whatever happens to the pool afterwards.",
          "name": "seized",
          "type_": "i128"
        },
        {
          "doc": "Slots already due when the collateral was posted. The collateral backs\\nthe schedule *from here forward*; it is not a retroactive fine.",
          "name": "slots_due_at_deposit",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "total_distributions",
          "type_": "u32"
        },
        {
          "doc": "0 when no exit is pending.",
          "name": "withdraw_announced_at",
          "type_": "u64"
        }
      ]
    }
  },
