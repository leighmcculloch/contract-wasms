  {
    "function_v0": {
      "doc": "Pays `to` with any token that has a Soroswap route to USDC: pulls\\n`amount_in` of `token_in` from `from`, swaps it along `path` for\\nUSDC, then splits the received USDC exactly like `pay`. The swap is\\na plain call - any failure reverts the whole payment, since unlike a\\nyield-source outage there is no USDC to degrade to.",
      "name": "pay_with_token",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_usdc_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "path",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        }
      ],
      "outputs": []
    }
  },
