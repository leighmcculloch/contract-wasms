  {
    "function_v0": {
      "doc": "Opens a rate-lock order. Escrows `amount` from `customer` and snapshots\\nthe customer's settlement conditions. Does NOT read or freeze the oracle\\nrate \\xe2\\x80\\x94 `target_rate` is the customer's condition, not today's price.",
      "name": "lock",
      "inputs": [
        {
          "doc": "",
          "name": "customer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "target_rate",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "expiry",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "recipient",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "payout_ref",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u64",
            "error_type": "error"
          }
        }
      ]
    }
