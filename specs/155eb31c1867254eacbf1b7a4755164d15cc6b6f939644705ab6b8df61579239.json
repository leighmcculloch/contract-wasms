    "function_v0": {
      "doc": "Deploy-time initialization. Runs once, atomically, and cannot be re-run.\\n\\nReading `decimals()` from the token here does double duty: it keeps the hot path\\nfree of a cross-contract call, and it means a token address that does not actually\\nimplement SEP-41 fails at deploy, before the vault has ever held anything.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "owner",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "operator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_id",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "daily_cap",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "auto_approve_max",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
