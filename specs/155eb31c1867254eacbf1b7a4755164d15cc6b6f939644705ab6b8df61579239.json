  {
    "function_v0": {
      "doc": "Grant, extend or revoke the session key by setting the Unix time after which the\\nagent's `pay` stops working. A future time grants or extends, a past time (or the\\ncurrent one) revokes immediately, and 0 removes the time bound entirely.\\n`owner_pay` is never time-bound.",
      "name": "set_session_key_expiry",
      "inputs": [
        {
          "doc": "",
          "name": "expiry",
          "type_": "u64"
        }
      ],
      "outputs": []
    }
  },
  {
    "udt_error_enum_v0": {
      "doc": "",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "The owner froze the vault. The agent cannot spend at all; `owner_pay` still works.",
          "name": "Frozen",
          "value": 1
        },
        {
          "doc": "The session key's expiry has passed. The owner can extend, re-grant, or override.",
          "name": "SessionKeyExpired",
          "value": 2
        },
        {
          "doc": "The allowlist is on and this payee is not on it.",
          "name": "PayeeNotAllowed",
          "value": 3
        },
        {
          "doc": "A single payment above the auto-approve ceiling. This is the human-approval line.",
          "name": "AboveAutoApprove",
          "value": 4
        },
        {
          "doc": "This payment would take the UTC day's cumulative spend over the cap.",
          "name": "DailyCapExceeded",
          "value": 5
        },
        {
          "doc": "Amount is zero or negative. No Solidity analogue: `uint256` ruled it out.",
          "name": "InvalidAmount",
          "value": 6
        },
        {
          "doc": "Payee is the vault itself or the settlement token. No Solidity analogue.",
          "name": "InvalidPayee",
          "value": 7
        },
        {
          "doc": "The day accumulator would overflow. Reached through `checked_add`, never a panic.",
          "name": "MathOverflow",
          "value": 8
        },
        {
          "doc": "The vault does not hold enough to make this payment. Named here so an underfunded\\nvault gives a reason the human path can act on, instead of an opaque token panic.",
          "name": "InsufficientBalance",
          "value": 9
        },
        {
          "doc": "Owner and operator are the same address. Refused at construction and on\\n`set_operator`, because a single compromised key would then be able to both spend\\npast the policy and lift the policy. The TypeScript vault path already refuses\\nthis (`mcp/src/platform/vault.ts`); enforcing it here makes it unbypassable.",
          "name": "OwnerIsOperator",
          "value": 10
        }
      ]
    }
  },
