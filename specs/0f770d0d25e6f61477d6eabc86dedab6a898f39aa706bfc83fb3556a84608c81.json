    "function_v0": {
      "doc": "Admin-only. Materialize pre-existing stake positions on behalf of users\\n(used for pool-migration / recovery deploys). Callable multiple times\\nto fit into per-tx compute/write budgets.\\n\\nFor every call, the caller (admin) must hold LP tokens equal to the\\nbatch sum; the batch total is transferred from admin to this contract\\nas part of the same tx. Each entry MUST reference a user with no prior\\nstake position; attempting to seed the same user twice panics.",
      "name": "seed_stakes",
      "inputs": [
        {
          "doc": "",
          "name": "sender",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "entries",
          "type_": {
            "vec": {
              "element_type": {
                "tuple": {
                  "value_types": [
                    "address",
                    "i128"
                  ]
                }
              }
            }
          }
        }
      ],
      "outputs": []
    }
  },
