          "type_": "u64"
        },
        {
          "doc": "The rewards debt is a mechanism to determine how much a user has already been credited in terms of staking rewards.\\nWhenever a user deposits or withdraws staked tokens to the pool, the rewards for the user is updated based on the\\naccumulated rewards per share, and the difference is stored as reward debt. When claiming rewards, this reward debt\\nis used to determine how much rewards a user can actually claim.",
          "name": "reward_debt",
          "type_": "u128"
        },
        {
          "doc": "Vec of stakes sorted by stake timestamp",
          "name": "stakes",
          "type_": {
