  {
    "udt_struct_v0": {
      "doc": "Mirrors the EVM Statement struct.\\nDescribes a transaction to be authorized.",
      "lib": "",
      "name": "Statement",
      "fields": [
        {
          "doc": "Encoded function signature and arguments \\xe2\\x80\\x94 variable-length to match\\nthe EVM `bytes encodedSigAndArgs` field. Callers may pass the raw\\ncall data or a hash of it.",
          "name": "encoded_sig_and_args",
          "type_": "bytes"
        },
        {
          "doc": "Deadline ledger timestamp",
          "name": "expiration",
          "type_": "u64"
        },
        {
          "doc": "Original transaction sender",
          "name": "msg_sender",
          "type_": "address"
        },
        {
          "doc": "Value sent with the transaction (token amount).\\nEquivalent to EVM's msg.value \\xe2\\x80\\x94 included in signed digest so\\nattesters can constrain transaction value.",
          "name": "msg_value",
          "type_": "i128"
        },
        {
          "doc": "Policy identifier (e.g. \"x-a1b2c3d4e5f6g7h8\")",
          "name": "policy",
          "type_": "string"
        },
        {
          "doc": "Target contract address",
          "name": "target",
          "type_": "address"
        },
        {
          "doc": "Unique identifier \\xe2\\x80\\x94 replay protection key",
          "name": "uuid",
          "type_": "string"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Ed25519-signed authorization from an attester.",
      "lib": "",
      "name": "Attestation",
      "fields": [
        {
          "doc": "Ed25519 public key of the attester (32 bytes)",
          "name": "attester",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "Must match Statement.expiration",
          "name": "expiration",
          "type_": "u64"
        },
        {
          "doc": "Ed25519 signature (64 bytes)",
          "name": "signature",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        },
        {
          "doc": "Must match Statement.uuid",
          "name": "uuid",
          "type_": "string"
        }
      ]
    }
  },
