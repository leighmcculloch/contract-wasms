  {
    "function_v0": {
      "doc": "Validate an attestation against a statement.\\n\\nThe `caller` parameter implements the hashStatementSafe pattern:\\nit replaces `statement.target` with the actual caller address before\\nverifying the signature, preventing cross-contract replay attacks.\\nIn Soroban, the calling contract should pass `e.current_contract_address()`.",
      "name": "validate_attestation",
      "inputs": [
        {
          "doc": "",
          "name": "statement",
          "type_": {
            "udt": {
              "name": "Statement"
            }
          }
        },
        {
          "doc": "",
          "name": "attestation",
          "type_": {
            "udt": {
              "name": "Attestation"
            }
          }
        },
        {
          "doc": "",
          "name": "network",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bool",
            "error_type": {
              "udt": {
                "name": "RegistryError"
              }
            }
          }
        }
      ]
    }
  },
