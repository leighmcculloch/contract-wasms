  {
    "function_v0": {
      "doc": "The address that administers this adapter's allowlist.\\n\\nA view, added in Phase 11 alongside `caller()` and for the same reason\\n(ADR-037): `scripts/verify_deployment.sh` has to read the owner off the\\nchain rather than trust the deploy script's variable. The value was\\nalways stored \\xe2\\x80\\x94 `initialize` takes it \\xe2\\x80\\x94 but nothing exposed it, so the\\none check that would catch an adapter initialized by the wrong key was\\nthe one check that could not be made.",
      "name": "owner",
      "inputs": [],
      "outputs": [
        {
          "result": {
            "ok_type": "address",
            "error_type": {
              "udt": {
                "name": "AdapterError"
              }
            }
          }
        }
      ]
    }
  },
