            "element_type": "address"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "The one contract permitted to invoke this adapter.\\n\\nA view, added in Phase 11 for `scripts/verify_deployment.sh`. The binding\\nis the single most error-prone fact in a deployment \\xe2\\x80\\x94 a venue reachable\\nfrom three contracts needs three adapter instances, and one bound to the\\nwrong caller passes every other check and fails on the first user call.\\nA deployment invariant that cannot be read cannot be verified.",
      "name": "caller",
      "inputs": [],
      "outputs": [
        {
          "result": {
            "ok_type": "address",
            "error_type": {
              "udt": {
                "name": "AdapterError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "# Verification\\n\\nThe measured quantity follows `action`, never the op list: a batch that\\nsupplies collateral *and* borrows is measured on whichever of the two the\\ncaller said it was doing, and `min_out` bounds that one. The other legs\\nstill happen \\xe2\\x80\\x94 they are simply not what this call promised.\\n\\nEvery measurement is a before/after read of the pool by this adapter.\\n`submit` returns `Positions` and it is ignored (ADR-007).",
      "name": "execute",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "action",
          "type_": {
            "udt": {
              "name": "Action"
            }
          }
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "beneficiary",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "min_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "params",
          "type_": {
            "udt": {
              "name": "AdapterParams"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "udt": {
                "name": "Outcome"
              }
            },
            "error_type": {
              "udt": {
                "name": "AdapterError"
              }
            }
          }
        }
      ]
    }
  },
