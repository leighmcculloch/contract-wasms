        {
          "doc": "Stored storage version is not one this build knows how to migrate from.",
          "name": "StorageVersionMismatch",
          "value": 40
        },
        {
          "doc": "Target address is not allowlisted.",
          "name": "TargetNotAllowed",
          "value": 50
        },
        {
          "doc": "Target is allowlisted but this entry point on it is not.",
          "name": "EntryPointNotAllowed",
          "value": 51
        },
        {
          "doc": "Checked arithmetic overflowed.",
          "name": "MathOverflow",
          "value": 60
        },
        {
          "doc": "Checked arithmetic underflowed.",
          "name": "MathUnderflow",
          "value": 61
        },
        {
          "doc": "Division by zero.",
          "name": "DivideByZero",
          "value": 62
        },
        {
          "doc": "A basis-points value exceeded 10_000.",
          "name": "BpsOutOfRange",
          "value": 63
        },
        {
          "doc": "A set of basis-points values did not sum to exactly 10_000.",
          "name": "BpsSumMismatch",
          "value": 64
