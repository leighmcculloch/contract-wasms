    "udt_struct_v0": {
      "doc": "Blend's `Positions`.\\n\\nAll three maps use `u32` reserve index keys \\xe2\\x80\\x94 NOT asset addresses. Blend v2\\nstores positions by the reserve's index in the pool (from `get_reserve`).\\nThis matches the deployed pool's actual return type from `get_positions`.\\n\\nAll three maps are declared because a `#[contracttype]` struct decodes\\nstrictly \\xe2\\x80\\x94 a mirror missing a field the pool returns fails at the XDR\\nboundary. This adapter genuinely reads all three.",
      "lib": "",
      "name": "Positions",
      "fields": [
        {
          "doc": "",
          "name": "collateral",
          "type_": {
            "map": {
              "key_type": "u32",
              "value_type": "i128"
            }
          }
        },
        {
          "doc": "",
          "name": "liabilities",
