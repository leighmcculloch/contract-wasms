  {
    "function_v0": {
      "doc": "Attempt to settle the market by reading the oracle price.\\n\\nAnyone can call this \\xe2\\x80\\x94 it is permissionless. The watcher calls it every 60s.\\nThe contract's settlement logic (settlement.rs) handles:\\n- Expiry detection \\xe2\\x86\\x92 NO wins\\n- Depeg detection + breach timer \\xe2\\x86\\x92 YES wins\\n- Freshness checks on oracle data",
      "name": "try_settle",
      "inputs": [],
      "outputs": []
    }
  },
  {
