  {
    "function_v0": {
      "doc": "Underwriter deposits `amount` USDC and receives `amount` YES + `amount` NO tokens.\\n\\nThe complete set invariant: every YES token has exactly one paired NO token,\\nand together they are always worth exactly $1 USDC (after settlement).\\n\\nTypical underwriter flow:\\n1. mint_complete_set(amount)\\n2. place_order(is_buy=false, price_bps=150, amount)  // sell YES at 1.5% premium\\n3. Keep NO tokens \\xe2\\x80\\x94 collect if market expires without failure",
      "name": "mint_complete_set",
      "inputs": [
        {
          "doc": "",
          "name": "underwriter",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
