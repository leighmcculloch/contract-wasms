    "function_v0": {
      "doc": "After settlement, token holders redeem their winning tokens for $1 USDC each.\\n\\nYES wins (Settled state): YES holders get $1 USDC per YES token\\nNO wins (Expired state): NO holders get $1 USDC per NO token\\n\\nTokens are burned (balance set to 0) on claim \\xe2\\x80\\x94 cannot double-claim.",
      "name": "claim",
      "inputs": [
        {
          "doc": "",
          "name": "holder",
          "type_": "address"
        }
      ],
      "outputs": []
    }
