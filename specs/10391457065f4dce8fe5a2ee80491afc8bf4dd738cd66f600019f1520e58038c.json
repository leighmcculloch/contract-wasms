  {
    "function_v0": {
      "doc": "Place a limit order.\\n\\nis_buy=true  \\xe2\\x86\\x92 buying YES tokens (buying insurance cover), pays USDC\\nis_buy=false \\xe2\\x86\\x92 selling YES tokens (underwriter collecting premium), locks YES\\n\\nprice_bps: 1\\xe2\\x80\\x939999 basis points (1 = 0.01%, 9999 = 99.99%)\\ne.g. 150 bps = buyer pays 1.5 USDC for 100 YES tokens (1.5% premium)",
      "name": "place_order",
      "inputs": [
        {
          "doc": "",
          "name": "owner",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "is_buy",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "price_bps",
          "type_": "i64"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        "u64"
      ]
    }
  },
