  {
    "function_v0": {
      "doc": "One-time pool setup (idempotent \\xe2\\x80\\x94 errors if already initialized). Zeroes reserves and\\nregisters this contract as its own SEP-41 LP token.\\n- `admin`: owner authorized for the admin-gated entrypoints (fee/ramp changes, fee sweeps)\\n- `tokens`: one SAC per coin (`2..=MAX_COINS`); each rate is derived from the SAC decimals\\n- `amplification`: pre-scaled `A * A_PRECISION` (the pool starts static at this value)\\n- `fee` / `admin_fee` / `offpeg_fee_multiplier`: over `FEE_DENOMINATOR`",
      "name": "initialize",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "tokens",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "amplification",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "fee",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "admin_fee",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "offpeg_fee_multiplier",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Last spot price of coin `i` vs coin 0.",
      "name": "last_price",
      "inputs": [
        {
