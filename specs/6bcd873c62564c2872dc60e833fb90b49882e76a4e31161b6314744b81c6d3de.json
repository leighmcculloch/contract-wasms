[
  {
    "udt_error_enum_v0": {
      "doc": "Smart contract errors: every engine/curve failure maps here, plus errors raised by the\\nadapter itself at the host boundary (e.g. type conversions, initialization checks).\\n\\nThe discriminants are a published ABI \\xe2\\x80\\x94 never renumber or reorder existing errors, only append.",
      "lib": "",
      "name": "Error",
      "cases": [
        {
          "doc": "",
          "name": "InvalidCoinCount",
          "value": 1
        },
        {
          "doc": "",
          "name": "InvalidCoinIndex",
          "value": 2
        },
        {
          "doc": "",
          "name": "SameCoin",
          "value": 3
        },
        {
          "doc": "",
          "name": "DivisionByZero",
          "value": 4
        },
        {
          "doc": "",
          "name": "Arithmetic",
          "value": 5
        },
        {
          "doc": "",
          "name": "ZeroBalance",
          "value": 6
        },
        {
          "doc": "",
          "name": "InvalidFee",
          "value": 7
        },
        {
          "doc": "",
          "name": "InvalidAmplification",
          "value": 8
        },
        {
          "doc": "",
          "name": "NotConverged",
          "value": 9
        },
        {
          "doc": "",
          "name": "SlippageExceeded",
          "value": 10
        },
        {
          "doc": "",
          "name": "ZeroAmount",
          "value": 11
        },
        {
          "doc": "",
          "name": "InsufficientBalance",
          "value": 12
        },
        {
          "doc": "",
          "name": "ZeroBurn",
          "value": 13
        },
        {
          "doc": "A value did not fit the `ruint::U256` \\xe2\\x86\\x94 `i128` boundary (negative, or `> i128::MAX`).",
          "name": "ConversionOutOfRange",
          "value": 14
        },
        {
          "doc": "An entrypoint was called before `initialize`.",
          "name": "NotInitialized",
          "value": 15
        },
        {
          "doc": "`initialize` was called twice.",
          "name": "AlreadyInitialized",
          "value": 16
        },
        {
          "doc": "`admin_fee` exceeds `FEE_DENOMINATOR` (rejected at `initialize`).",
          "name": "InvalidAdminFee",
          "value": 17
        },
        {
          "doc": "`offpeg_fee_multiplier` is below `FEE_DENOMINATOR` (rejected at `initialize`).",
          "name": "InvalidOffpegFeeMultiplier",
          "value": 18
        },
        {
          "doc": "An engine `Role` with no on-chain binding was reached (should be unreachable).",
          "name": "Unreachable",
          "value": 19
        },
        {
          "doc": "The SEP-41 token's `total_supply` diverged from the engine's `next_state.lp_supply` after executing a plan.",
          "name": "LpSupplyDrift",
          "value": 20
        },
        {
          "doc": "An entrypoint option that depends on a not-yet-shipped feature was requested\\n(e.g. `remove_liquidity(claim_admin_fees = true)` before admin-fee withdrawal exists).",
          "name": "NotImplemented",
          "value": 21
        },
        {
          "doc": "An admin-gated entrypoint was called by an address other than the stored `admin`.",
          "name": "Unauthorized",
          "value": 22
        },
        {
          "doc": "A ramp's timing is invalid \\xe2\\x80\\x94 started too soon after the last one, or too short a duration.",
          "name": "InvalidRampTime",
          "value": 23
        },
        {
          "doc": "A ramp's target `A` is out of range or changes `A` by more than the per-ramp bound.",
          "name": "InvalidRampTarget",
          "value": 24
        }
      ]
    }
  },
