  {
    "function_v0": {
      "doc": "Deploy-time init: pin the ONE USDC SAC token this escrow escrows, and set the owner\\n(the upgrade/pause authority \\xe2\\x80\\x94 a timelock/multisig on mainnet; renounced to immutable\\nafter audit). The owner has NO path that moves escrowed funds (invariant 13).",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "owner",
          "type_": "address"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "The EXACT bytes the link key must sign for a claim. Exposed as a view so the client can\\nbuild the identical message (or simulate this) \\xe2\\x80\\x94 signature parity is critical. Layout:\\ntag(1) ++ network_id(32) ++ contract_address_xdr ++ link_pubkey(32) ++ payout_xdr\\nBinding contract + network blocks cross-contract / cross-network replay.",
      "name": "claim_message",
      "inputs": [
        {
          "doc": "",
          "name": "kind",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "link",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "payout",
          "type_": "address"
        }
      ],
      "outputs": [
        "bytes"
      ]
    }
  },
