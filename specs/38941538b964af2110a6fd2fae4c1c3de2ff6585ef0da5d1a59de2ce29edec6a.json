  {
    "function_v0": {
      "doc": "Claim a one-to-one drop to the chosen `payout`. Submittable by ANYONE (a relayer paying\\nthe fee): the funds go ONLY to `payout`, and only if the link key signed exactly this\\n(contract, network, link, payout). No `require_auth` \\xe2\\x80\\x94 the Ed25519 signature IS the\\nauthorization, which is what makes it walletless + gasless.",
      "name": "claim",
      "inputs": [
        {
          "doc": "",
          "name": "link",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "payout",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "sig",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Emergency brake: stops NEW escrow only (deposit/create_drop). Exits never pause.",
      "name": "pause",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        }
      ],
      "outputs": []
    }
  },
