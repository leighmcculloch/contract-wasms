      "outputs": [
        "bool"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Sender locks `amount` USDC for whoever holds the link secret for `link` (its Ed25519\\npublic key). `expiry` is a unix timestamp; after it, an unclaimed drop is reclaimable.\\n\\nPause gates ONLY the two escrow-creating entrypoints (`deposit` + `create_drop`) \\xe2\\x80\\x94\\n`claim`/`claim_share`/`reclaim`/`reclaim_pool` are NEVER pausable, so every escrowed\\ndollar can always exit to its rightful owner in any state (invariant 14).",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "link",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "expiry",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "After expiry, the original sender reclaims an unclaimed drop (the 7-day safety net).",
      "name": "reclaim",
      "inputs": [
        {
          "doc": "",
          "name": "link",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
