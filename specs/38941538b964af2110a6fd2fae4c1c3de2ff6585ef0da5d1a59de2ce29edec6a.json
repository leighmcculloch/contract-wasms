  {
    "function_v0": {
      "doc": "Claim one share of a group pool to `payout`. Submittable by anyone (relayer). Each\\ndistinct payout may claim at most once; funds go only to the link-signed payout.",
      "name": "claim_share",
      "inputs": [
        {
          "doc": "",
          "name": "link",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "payout",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "sig",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Fund a pool of `slots` equal shares behind `link`. `amount` USDC is pulled from `from`;\\neach of the first `slots` distinct payouts claims `amount / slots`. Pause-gated like\\n`deposit` (new escrow only \\xe2\\x80\\x94 exits are never pausable, invariant 14).",
      "name": "create_drop",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "link",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "slots",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "expiry",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "After expiry, the sender reclaims any unclaimed shares (and dust) of a pool.",
