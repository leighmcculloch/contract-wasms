  {
    "udt_union_v0": {
      "doc": "Context of a single authorized call performed by an address.\\n\\nCustom account contracts that implement `__check_auth` special function\\nreceive a list of `Context` values corresponding to all the calls that\\nneed to be authorized.",
      "lib": "",
      "name": "Context",
      "cases": [
        {
          "tuple_v0": {
            "doc": "Contract invocation.",
            "name": "Contract",
            "type_": [
              {
                "udt": {
                  "name": "ContractContext"
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "Contract that has a constructor with no arguments is created.",
            "name": "CreateContractHostFn",
            "type_": [
              {
                "udt": {
                  "name": "CreateContractHostFnContext"
                }
              }
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "Contract that has a constructor with 1 or more arguments is created.",
            "name": "CreateContractWithCtorHostFn",
            "type_": [
              {
                "udt": {
                  "name": "CreateContractWithConstructorHostFnContext"
                }
              }
            ]
          }
        }
      ]
    }
  },
