  {
    "function_v0": {
      "doc": "Start the withdrawal countdown. Anyone with a signed transaction\\nfrom the owner can call this \\xe2\\x80\\x94 that's the whole point: if an\\nattacker calls it, the REAL owner sees it pending and has the\\nfull `cooling_off_duration_seconds` window to `cancel_withdrawal`.",
      "name": "initiate_withdrawal",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "vault_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u64",
            "error_type": "error"
          }
        }
      ]
    }
  },
