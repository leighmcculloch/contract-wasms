  {
    "function_v0": {
      "doc": "Withdraw the full vault balance. Behavior depends on `kind`:\\n- TimeLock: blocked until `unlock_timestamp`.\\n- CoolingOff: blocked until a withdrawal was `initiate_withdrawal`'d\\nAND the cooling-off duration has elapsed since.\\n- DeadManSwitch: the OWNER can always withdraw here (any time,\\nsubject only to the backup not having already claimed).\\n- Vesting: NOT withdrawable via this method \\xe2\\x80\\x94 use\\n`withdraw_vested` instead (partial, schedule-gated amounts).",
      "name": "withdraw",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "vault_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
