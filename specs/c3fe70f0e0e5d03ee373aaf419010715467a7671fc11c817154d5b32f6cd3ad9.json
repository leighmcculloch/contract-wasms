  {
    "function_v0": {
      "doc": "Burns `amount` YT from `from`, on a holder's own direct call. The\\nholder is settled first so their accrued yield is banked before the\\nbalance shrinks, at a rate observed through the tokenizer. The\\ntokenizer's recombine burns through `burn_settled` instead, passing the\\nrate down, because it is on the call stack here and cannot be called\\nback into.\\n\\nThis can drop YT total_supply below PT total_supply by design \\xe2\\x80\\x94 not a\\nbug. No economic path reads YT total_supply; the tokenizer's escrow,\\nPT-senior cap, and pro-rata math read only `pt_total_supply`.",
      "name": "burn",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Mints `amount` YT to `to`. Restricted to the tokenizer recorded at\\ninitialization, which mints YT when a holder splits SY. The recipient is\\nsettled first, so a fresh holder's checkpoint starts at the current rate\\nand an existing holder's prior yield is banked before the balance grows.",
      "name": "mint",
      "inputs": [
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
