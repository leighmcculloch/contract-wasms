  {
    "function_v0": {
      "doc": "Burns `amount` YT from `from`, settling them first at the `rate`\\nsupplied by the tokenizer. Restricted to the tokenizer, which calls\\nthis from `recombine` while it is on the call stack: yt cannot call\\nback into it to observe a rate, so the tokenizer hands down the same\\nrate it observed in that transaction. Trusting the argument is safe\\nbecause of the auth gate, the same model as `settle` and `consume`.\\nThe holder's own authorization is enforced by `recombine` itself.",
      "name": "burn_settled",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "rate",
          "type_": "i128"
        }
      ],
      "outputs": [
