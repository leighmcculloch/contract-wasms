  {
    "function_v0": {
      "doc": "Subtracts exactly `amount` SY shares from `holder`'s banked ledger.\\nRestricted to the tokenizer, which calls this after `settle` and pushes the\\nsame `amount` of SY out of escrow itself. Moves no tokens. `amount == 0` is\\na no-op; `amount` must be `<= banked` (the tokenizer only ever consumes what\\na prior `settle` reported), enforced so the ledger can never go negative.\\nThe remainder stays banked and claimable later once escrow can cover it.",
      "name": "consume",
      "inputs": [
        {
          "doc": "",
          "name": "holder",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
