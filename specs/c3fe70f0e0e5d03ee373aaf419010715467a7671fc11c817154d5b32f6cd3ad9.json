  {
    "function_v0": {
      "doc": "Total SY shares claimable by `holder` right now: already-banked yield\\nplus what a settle at the current SY rate would add. The contract reads\\nthe rate from the SY contract itself, so no caller can supply a fake one.\\n\\nBefore maturity this is a point-in-time read of the live rate, so the\\nexecuted `claim_yield` amount may differ if the rate moves between this\\nquote and submission. After maturity it uses the tokenizer's frozen\\nmaturity rate (see `preview_rate`), so it no longer tracks live accrual.",
      "name": "preview_claim_yield",
      "inputs": [
        {
          "doc": "",
          "name": "holder",
          "type_": "address"
        }
      ],
      "outputs": [
