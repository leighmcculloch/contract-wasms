    }
  },
  {
    "function_v0": {
      "doc": "Insert a new leaf into the Merkle tree\\n\\nAdds a new member to the Merkle tree and updates the root. The leaf is\\ninserted at the next available index and the tree is updated efficiently\\nby only recomputing the hashes along the path to the root. If\\n`admin_insert_only` is enabled (the default), only the admin can insert\\nleaves; otherwise, anyone can call this function.",
      "name": "insert_leaf",
      "inputs": [
        {
          "doc": "",
          "name": "leaf",
          "type_": "u256"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
