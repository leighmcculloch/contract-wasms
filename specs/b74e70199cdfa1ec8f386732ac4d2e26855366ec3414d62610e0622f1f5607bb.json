    "udt_union_v0": {
      "doc": "Optional per-leg swap. Semantically `Option<SwapLeg>`, but expressed as a\\ndedicated `#[contracttype]` enum: soroban-sdk 26 cannot derive the (testutils)\\nXDR conversions for an `Option<CustomStruct>` *struct field*, because the\\n`Option<T> -> ScVal` blanket requires `T: Into<ScVal>` (infallible) while a\\n`#[contracttype]` struct is only `TryFrom<_> for ScVal` (fallible). An enum\\ngoes through the Val path and has no such bound. T1 always uses `None`.",
      "lib": "",
      "name": "MaybeSwap",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "None"
          }
