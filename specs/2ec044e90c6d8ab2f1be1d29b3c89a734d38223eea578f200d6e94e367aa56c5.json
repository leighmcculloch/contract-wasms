  {
    "udt_struct_v0": {
      "doc": "A single immutable disbursement record. Once written it is never mutated:\\nthe on-chain ledger of who received what, when, keyed by a 32-byte\\n`grant_ref` (sha256 of the app's grant id) so the app can address it\\ndirectly and so the same grant can never be paid out twice.",
      "lib": "",
      "name": "Disbursement",
      "fields": [
        {
          "doc": "Amount paid in the token's minor units (stroops for XLM; 7 decimals).",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "Ledger sequence the disbursement landed on (proof-of-time).",
          "name": "ledger",
          "type_": "u32"
        },
        {
          "doc": "The address the pool paid.",
          "name": "recipient",
          "type_": "address"
        }
      ]
    }
  },
