  {
    "function_v0": {
      "doc": "Claim `message`, swap the minted USDC to XLM, send it to the beneficiary encoded in the\\nmessage's hook payload. Returns the XLM delivered (stroops).\\n\\nPermissionless: the caller picks the route and the slippage floor but cannot influence\\nwhere the funds go. Same shape as the EVM-side `sweep` escape hatch.\\n\\nIf the beneficiary account does not exist yet, the native SAC transfer creates it \\xe2\\x80\\x94\\nwhich requires delivering at least 1 XLM (2 x 0.5 base reserve).",
      "name": "deliver",
      "inputs": [
        {
          "doc": "",
          "name": "message",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "attestation",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "distribution",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "DexDistribution"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "min_xlm_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "deadline",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
