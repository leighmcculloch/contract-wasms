  {
    "udt_union_v0": {
      "doc": "Direction for the residue after a truncated integer division.\\n\\n`#[contracttype]` is required because `Rounding` appears in the public ABI\\nof the `SpectraFungibleVaultWrapper` trait\\n(`convert_to_shares_with_rounding` / `convert_to_assets_with_rounding`),\\nwhich is surfaced as on-chain entry points via `#[contractimpl]`. Without\\nthe derive, downstream contracts that depend on `spectra-math` and re-export\\nthe type through a `#[contractimpl]` method fail to build with\\n`IntoVal<Env, Val>` errors.",
      "lib": "",
      "name": "Rounding",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "Floor"
          }
