  {
    "udt_enum_v0": {
      "doc": "High-level compliance status for an address.\\nThe ComplianceStatus determines whether the address may use the\\nprotocol at all \\xe2\\x80\\x94 there are no KYC tiers, a user is either verified\\nor they are not.",
      "lib": "",
      "name": "ComplianceStatus",
      "cases": [
        {
          "doc": "Never attested \\xe2\\x80\\x94 no KYC provider has ever submitted an attestation.",
          "name": "Unknown",
          "value": 0
        },
        {
          "doc": "KYC submitted but not yet fully verified (e.g. documents under review).",
          "name": "Pending",
          "value": 1
        },
        {
          "doc": "Fully verified \\xe2\\x80\\x94 may use the protocol within the limits of their\\njurisdiction.",
          "name": "Verified",
          "value": 2
        },
        {
          "doc": "Temporarily suspended (regulatory review, investigation, or admin\\naction). May not use the protocol until unsuspended.",
          "name": "Suspended",
          "value": 3
        },
        {
          "doc": "Permanently blocked (OFAC / sanctions list). May never use the\\nprotocol \\xe2\\x80\\x94 this status cannot be self-cured.",
          "name": "Sanctioned",
          "value": 4
        },
        {
          "doc": "KYC attestation has passed its expiry date and must be renewed.",
          "name": "Expired",
          "value": 5
        }
      ]
    }
  },
