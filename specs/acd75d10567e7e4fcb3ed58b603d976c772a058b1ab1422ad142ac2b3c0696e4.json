    "function_v0": {
      "doc": "Lets the recipient (the `trader` field) exit a Pending agreement and\\nrecover their bond if the sender never funds it. There is no deadline in\\nPending, so without this the bond could be stranded by an absent sender.\\nReturns the bond to the recipient and any already-deposited capital to the\\nsender, then cancels.",
      "name": "reclaim_bond",
      "inputs": [
        {
          "doc": "",
          "name": "agreement_id",
          "type_": "u64"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
