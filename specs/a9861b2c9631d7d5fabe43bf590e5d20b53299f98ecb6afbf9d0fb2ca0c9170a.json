  {
    "udt_enum_v0": {
      "doc": "Identifies which cryptographic scheme and encoding format the project's\\nsecurity and verification contracts use.\\n\\nThis is set once at construction time and cannot be changed. It tells\\noff-chain tooling and other contracts which pipeline variant this\\nproject uses:\\n\\n- **`Ethereum`** \\xe2\\x80\\x94 secp256k1 keys, EIP-191 signatures, ABI-encoded\\nenvelopes. Use this when the same signed payloads need to be\\nverifiable on both Ethereum (or other EVM chains) and Stellar.\\n\\n- **`Stellar`** \\xe2\\x80\\x94 ed25519 keys, SEP-0053 signatures, XDR-encoded\\nenvelopes. Use this for Soroban-native solutions that don't need\\nEVM compatibility, giving better efficiency and simpler DevX.",
      "lib": "",
      "name": "VerificationType",
      "cases": [
        {
          "doc": "Secp256k1 / EIP-191 / ABI \\xe2\\x80\\x94 Ethereum-compatible multi-chain format.",
          "name": "Ethereum",
          "value": 1
        },
        {
          "doc": "Ed25519 / SEP-0053 / XDR \\xe2\\x80\\x94 Soroban-native format.",
          "name": "Stellar",
          "value": 2
        }
      ]
    }
