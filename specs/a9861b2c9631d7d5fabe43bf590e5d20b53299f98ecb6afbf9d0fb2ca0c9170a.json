  {
    "event_v0": {
      "doc": "Emitted when the BLND claim leg of `execute_harvest_yield` succeeded but\\nthe interest leg (withdraw \\xe2\\x86\\x92 resupply \\xe2\\x86\\x92 donate) was skipped because\\nBlend's `submit(WITHDRAW)` reverted \\xe2\\x80\\x94 usually pool utilization at 100%\\nor a frozen reserve mid-flight. `blnd_routed` is preserved (BLND went to\\ntreasury); `interest_donated` for the cycle is zero. Monitoring SHOULD\\nalert on this event so the operator can investigate Blend health before\\nthe next harvest tick.",
      "lib": "",
      "name": "HarvestPartial",
      "prefix_topics": [
        "harvest_partial"
      ],
      "params": [
        {
          "doc": "",
          "name": "blnd_routed",
          "type_": "i128",
          "location": "data"
        }
      ],
      "data_format": "map"
    }
  },
  {
    "event_v0": {
      "doc": "Emitted when `execute_harvest_yield` ran but produced no observable\\nmovement (no BLND claimed, no USDC interest donated). The cron tick\\nstill fired; monitoring can use this event to confirm operator\\nliveness while gating \"last_harvest_ts hasn't advanced\" on real work.\\n`reason` is one of: `\"noprin\"` (handler holds nothing in Blend),\\n`\"frozen\"` (Blend pool status > healthy max), `\"noyield\"` (interest\\nleg ran but yielded zero AND BLND claim returned zero).",
      "lib": "",
      "name": "HarvestSkipped",
      "prefix_topics": [
        "harvest_skipped"
      ],
      "params": [
        {
          "doc": "",
          "name": "reason",
          "type_": "symbol",
          "location": "data"
        }
      ],
      "data_format": "map"
    }
  },
  {
    "event_v0": {
      "doc": "Emitted whenever `principal_supplied` shrinks because Blend redeemed\\nfewer USDC than the handler accounts for. The shortfall is exactly\\n`previous_principal - redeemable`. Monitoring dashboards SHOULD alert\\non this event since it indicates Blend recorded a bad-debt write-down\\nagainst the handler's b-token position.",
      "lib": "",
      "name": "BadDebtDetected",
      "prefix_topics": [
        "bad_debt_detected"
