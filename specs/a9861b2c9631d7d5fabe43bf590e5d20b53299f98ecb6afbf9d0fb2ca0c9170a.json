      "inputs": [],
      "outputs": [
        "u64"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Admin-only: pull `amount` USDC from Blend back to the blended pool\\nout of band. The dual of `manual_to_blend`. `emergency_unwind` is\\nthe right tool for a full drain; this exists for partial unwinds\\nwhere the admin wants tactical control over the amount.",
      "name": "manual_from_blend",
      "inputs": [
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
