  {
    "function_v0": {
      "doc": "Admin-only: push `amount` USDC from the blended pool to Blend out\\nof band. Useful for the initial seeding right after deploy (when\\nno swap events have fired) and for manual top-ups during operator\\ndowntime.\\n\\nBypasses cooldown, band, min-total, and scope-limit gates because\\nthe admin already exercised judgement. Still honours pause and the\\nBlend-health gate (a Supply into a Frozen pool would revert anyway).",
      "name": "manual_to_blend",
      "inputs": [
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Admin-only: drain the entire Blend USDC position back to the pool's\\nliquid balance, bypassing cooldown / band / scope-limit gating.\\n\\nOperationally this is the off-ramp when Blend's status goes Frozen,\\nwhen the operator network is paused but funds need to come home, or\\nwhen migrating to a new handler.\\n\\nMechanic:\\n1. `Blend.submit(Withdraw, USDC, i128::MAX)` \\xe2\\x86\\x92 handler holds USDC.\\n2. Deposit `min(redeemed, principal_before)` back via\\n`deposit_from_delegate`; this matches the pool's\\n`delegated_out_*` counter so the call doesn't underflow.\\n3. Donate any excess (accrued interest) to the pool via `donate`.\\n4. Reset `principal_supplied = 0`.",
      "name": "emergency_unwind",
      "inputs": [],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "",
      "name": "target_ratio_bps",
      "inputs": [],
      "outputs": [
        "u32"
      ]
    }
