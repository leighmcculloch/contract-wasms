          "tuple_v0": {
            "doc": "",
            "name": "Kid",
            "type_": [
              "string"
            ]
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "KeyCount"
          }
        },
        {
          "void_v0": {
            "doc": "How many enumerated keys are currently VALID. `KeyCount` counts every\\nhash ever enumerated (revoked ones keep their slot), so it cannot be\\nused for the `MIN_ACTIVE_KEYS` floor. Maintained incrementally rather\\nthan derived by scanning the enumeration: a scan is O(KeyCount)\\npersistent reads inside `revoke`, and KeyCount grows by one on every\\nGoogle key rotation, so it would eventually blow the per-transaction\\nfootprint limit and disable the fail-safe revocation path outright.",
            "name": "ActiveKeyCount"
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "KeyAt",
            "type_": [
              "u32"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "Reverse lookup hash -> enumeration index, so re-registering or\\nrevoking a key can re-extend its `KeyAt` entry's TTL without scanning.\\nPresence also marks \"this hash has an enumeration slot\", which keeps\\nrevoke -> re-register cycles from appending duplicate slots.",
            "name": "KeyIndex",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
                }
              }
            ]
          }
        },
        {
          "void_v0": {
            "doc": "Hot-path service account: may only *propose* keys (timelocked) and\\nrevoke them (fail-safe direction). Set by the owner.",
            "name": "Operator"
          }
        },
        {
          "void_v0": {
            "doc": "Seconds a proposed key must wait before `activate_key` succeeds.",
            "name": "ActivationDelay"
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "Pending",
            "type_": [
