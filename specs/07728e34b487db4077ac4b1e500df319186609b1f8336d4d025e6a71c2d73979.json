          "void_v0": {
            "doc": "Nominated successor in a two-step ownership handover. Set by\\n`propose_owner`, cleared on `accept_ownership`/`cancel_ownership_transfer`.",
            "name": "PendingOwner"
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "Key",
            "type_": [
              {
                "bytes_n": {
                  "n": 32
