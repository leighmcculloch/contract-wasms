  {
    "function_v0": {
      "doc": "Operator revocation (immediate). Fail-safe direction: the hot key can\\nonly ever disable keys, never enable them ahead of the delay.\\n\\nBounded by `MIN_ACTIVE_KEYS`: \"fail-safe\" only holds while at least a\\nworking keyset survives. Revoking the last keys is not a safe\\ndirection, it is a protocol-wide claim outage, so the operator is\\nstopped at the floor and the owner multisig must take over.",
      "name": "operator_revoke_key",
      "inputs": [
        {
          "doc": "",
          "name": "key_hash",
          "type_": {
            "bytes_n": {
              "n": 32
