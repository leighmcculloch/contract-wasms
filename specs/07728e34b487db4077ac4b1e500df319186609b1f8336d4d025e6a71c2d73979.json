        },
        {
          "void_v0": {
            "doc": "",
            "name": "PendingCount"
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "PendingAt",
            "type_": [
              "u32"
            ]
          }
        },
        {
          "tuple_v0": {
            "doc": "",
            "name": "PendingIndex",
