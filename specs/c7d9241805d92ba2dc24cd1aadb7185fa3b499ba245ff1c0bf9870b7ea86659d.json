    "function_v0": {
      "doc": "Store the verification key, Issuer public key, admin, USDC token, and fee.\\nCalled once after a fresh deploy.\\n\\n`fee_amount` \\xe2\\x80\\x94 issuance fee in USDC units (7 decimals).\\n0 = free (recommended for launch). 20_000_000 = 2.00 USDC.\\nAdjustable post-deploy via set_fee() without redeploying.",
      "name": "initialize",
      "inputs": [
        {
          "doc": "",
          "name": "vk",
          "type_": {
            "udt": {
              "name": "StoredVk"
            }
          }
        },
        {
          "doc": "",
          "name": "issuer_pub_key",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "treasury",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "usdc_token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "fee_amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "AgeVerifierError"
              }
            }
          }
        }
      ]
    }
  },
  {
