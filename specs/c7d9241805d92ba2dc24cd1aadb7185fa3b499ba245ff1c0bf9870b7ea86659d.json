  {
    "function_v0": {
      "doc": "Admin \\xe2\\x80\\x94 initiate a withdrawal. Funds are locked for 48h before execution.\\n\\nSecurity model: if the admin key is compromised, this 48h window gives the\\nteam time to detect the attack and rotate the key (via Stellar account management)\\nbefore `execute_withdraw()` can be called with the old compromised key.\\n\\nRecommended: configure the admin Stellar account as a 2-of-3 multisig so that\\na single compromised key cannot even reach this call unilaterally.",
      "name": "request_withdraw",
      "inputs": [
        {
          "doc": "",
          "name": "to",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "AgeVerifierError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Admin \\xe2\\x80\\x94 execute a previously requested withdrawal after the 48h timelock has expired.\\nRequires the current admin key \\xe2\\x80\\x94 a rotated key blocks a compromised key from executing.",
      "name": "execute_withdraw",
      "inputs": [],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "AgeVerifierError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Admin \\xe2\\x80\\x94 cancel a pending withdrawal request before the timelock expires.\\nCall this immediately after detecting a compromise to neutralize the attack.",
      "name": "cancel_withdraw",
      "inputs": [],
