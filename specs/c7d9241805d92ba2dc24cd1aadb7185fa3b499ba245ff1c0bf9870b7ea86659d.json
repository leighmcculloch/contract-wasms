  {
    "function_v0": {
      "doc": "Verify a Groth16 proof, collect the USDC issuance fee, and mint a soulbound credential.\\n\\n`caller`      \\xe2\\x80\\x94 address paying the fee and receiving the credential.\\nMust match the Stellar address used to derive pub_inputs[2].\\n`pub_inputs`  \\xe2\\x80\\x94 [isOldEnough: Fr(1), commitment: Fr, addressHash: Fr]\\n`nullifier`   \\xe2\\x80\\x94 unique 32-byte anti-replay token (random, client-side).\\n`issuer_sig`  \\xe2\\x80\\x94 Ed25519 signature (64 bytes) from the trusted Issuer over commitment bytes.",
      "name": "verify",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "proof",
          "type_": {
            "udt": {
              "name": "Groth16Proof"
            }
          }
        },
        {
          "doc": "",
          "name": "pub_inputs",
          "type_": {
            "vec": {
              "element_type": "u256"
            }
          }
        },
        {
          "doc": "",
          "name": "nullifier",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "issuer_sig",
          "type_": {
            "bytes_n": {
              "n": 64
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "bool",
            "error_type": {
              "udt": {
                "name": "AgeVerifierError"
              }
            }
          }
        }
      ]
    }
  },
  {
