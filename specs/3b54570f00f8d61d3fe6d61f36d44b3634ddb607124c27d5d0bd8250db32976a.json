  {
    "function_v0": {
      "doc": "Investor sends stablecoin proportional to their share.\\n`amount_cents` \\xe2\\x80\\x94 how much of the face value they want to buy.\\nInvestor pays `amount_cents * (1 - discount_bps/10000)`.\\n\\nKYC enforcement: The receivable token asset is issued with\\nAUTH_REQUIRED flag on the Stellar issuer account. The Stellar\\nprotocol prevents any non-authorized trustline from receiving\\ntokens \\xe2\\x80\\x94 so KYC is enforced at the protocol layer automatically.",
      "name": "buy_share",
      "inputs": [
        {
          "doc": "",
          "name": "investor",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "receivable_id",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "amount_cents",
          "type_": "i128"
        }
      ],
      "outputs": []
    }
  },
