  {
    "udt_union_v0": {
      "doc": "Storage keys. `Goal` lives in *persistent* storage (it must outlive the\\ncontract instance so funds are never stranded); `Admin`/`Token`/`Paused`/\\n`TotalSaved` live in *instance* storage so they share the instance TTL.",
      "lib": "",
      "name": "DataKey",
      "cases": [
        {
          "void_v0": {
            "doc": "",
            "name": "Admin"
          }
        },
        {
          "void_v0": {
            "doc": "Default token (the XLM Stellar Asset Contract) recorded at init.",
            "name": "Token"
          }
        },
        {
          "void_v0": {
            "doc": "",
            "name": "Paused"
          }
        },
        {
          "void_v0": {
            "doc": "Running total of all minor units ever deposited across every goal.",
            "name": "TotalSaved"
          }
        },
        {
          "tuple_v0": {
            "doc": "(saver, goal_id) -> Goal",
            "name": "Goal",
            "type_": [
              "address",
              {
                "bytes_n": {
                  "n": 32
                }
              }
            ]
          }
        }
      ]
    }
  },
  {
    "udt_enum_v0": {
      "doc": "Lifecycle of a saver's goal.\\nA goal starts `Saving`; it flips to `Reached` once its held balance meets the\\ntarget (purely informational \\xe2\\x80\\x94 withdraw is allowed in either state); it\\nbecomes `Withdrawn` once the saver pulls the full balance back out.",
      "lib": "",
      "name": "GoalStatus",
      "cases": [
        {
          "doc": "",
          "name": "Saving",
          "value": 0
        },
        {
          "doc": "",
          "name": "Reached",
          "value": 1
        },
        {
          "doc": "",
          "name": "Withdrawn",
          "value": 2
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "A single saver's goal, keyed in storage by `(saver, goal_id)`.\\n\\nThe contract custodies exactly `balance` minor units of `token` for this\\ngoal. `deposited` is the lifetime sum ever paid in (never decremented), so\\nthe UI can show \"saved so far\" even after a withdrawal.",
      "lib": "",
      "name": "Goal",
      "fields": [
        {
          "doc": "Balance currently held in the contract for this goal.",
          "name": "balance",
          "type_": "i128"
        },
        {
          "doc": "Lifetime total ever deposited (monotonic; survives withdrawals).",
          "name": "deposited",
          "type_": "i128"
        },
        {
          "doc": "Owner; the only address allowed to deposit to or withdraw this goal.",
          "name": "saver",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "status",
          "type_": {
            "udt": {
              "name": "GoalStatus"
            }
          }
        },
        {
          "doc": "Target the saver is working toward, in the token's minor units (7 dp).",
          "name": "target",
          "type_": "i128"
        },
        {
          "doc": "Stellar Asset Contract (SAC) address of the saved asset (XLM SAC by default).",
          "name": "token",
          "type_": "address"
        }
      ]
    }
  },
