    "function_v0": {
      "doc": "Deposit `amount` of `token` toward the `(saver, goal_id)` goal, locking it\\nin the contract. Creates the goal on first deposit (binding its `target`\\nand `token`); accumulates on subsequent deposits. Returns the new balance.\\n\\nAuth: requires the saver's signature. The same authorization covers the\\ninner SAC `transfer(saver -> contract)`.",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "saver",
          "type_": "address"
